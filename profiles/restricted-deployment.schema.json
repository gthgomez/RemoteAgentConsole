{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Restricted controller deployment policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "projects",
    "profiles",
    "allowedMachineMethods",
    "allowedSessionMethods",
    "forbiddenMethods"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["projectId", "canonicalPath", "directoryIdentity"],
        "properties": {
          "projectId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
          },
          "canonicalPath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "directoryIdentity": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\d+:\\d+$"
          }
        }
      },
      "maxItems": 128
    },
    "profiles": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "backendId", "commandFingerprint", "remoteSettings"],
        "properties": {
          "id": {
            "enum": ["command-code", "opencode", "codex", "babel"]
          },
          "backendId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
          },
          "commandFingerprint": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-f0-9]{64}$"
          },
          "remoteSettings": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": ["model", "mode"]
            },
            "maxItems": 2
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "id": {
                  "const": "babel"
                }
              },
              "required": ["id"]
            },
            "then": {
              "properties": {
                "remoteSettings": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["id", "backendId"],
            "properties": {
              "id": {
                "const": "command-code"
              },
              "backendId": {
                "const": "command-code"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["id", "backendId"],
            "properties": {
              "id": {
                "const": "opencode"
              },
              "backendId": {
                "const": "opencode"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["id", "backendId"],
            "properties": {
              "id": {
                "const": "codex"
              },
              "backendId": {
                "const": "codex"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["id", "backendId"],
            "properties": {
              "id": {
                "const": "babel"
              },
              "backendId": {
                "const": "babel"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "allowedMachineMethods": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
      },
      "maxItems": 128
    },
    "allowedSessionMethods": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
      },
      "maxItems": 128
    },
    "forbiddenMethods": {
      "type": "array",
      "uniqueItems": true,
      "contains": {
        "enum": [
          "bash",
          "daemon.terminal.ensure",
          "daemon.terminal.input",
          "writeFile",
          "deletePath",
          "capabilities.invoke"
        ]
      },
      "minContains": 6,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"
      },
      "maxItems": 128
    }
  }
}
