{
  "name": "remote-agent-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "check:workspace": "node scripts/check-workspace.mjs",
    "dev": "pnpm --recursive --parallel --if-present dev",
    "build": "pnpm --recursive --if-present build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present test",
    "verify": "pnpm check:workspace && biome check . && pnpm typecheck && pnpm test",
    "composition:verify": "node distribution/build-composition.mjs verify",
    "composition:stage": "node distribution/build-composition.mjs stage",
    "composition:build-reference": "node distribution/build-composition.mjs build-reference",
    "composition:fixtures": "node qualification/run-fixtures.mjs",
    "test:history": "node --test qualification/migration.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "typescript": "^5.9.3"
  }
}
