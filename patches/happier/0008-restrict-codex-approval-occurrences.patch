diff --git a/apps/cli/src/agent/permissions/approvalDecisionPolicy.ts b/apps/cli/src/agent/permissions/approvalDecisionPolicy.ts
new file mode 100644
index 0000000..abedcf0
--- /dev/null
+++ b/apps/cli/src/agent/permissions/approvalDecisionPolicy.ts
@@ -0,0 +1,156 @@
+import type { PermissionResult } from './permissionResult';
+
+/**
+ * Restricted-deployment approval policy.
+ *
+ * Restricted deployments allow an explicit owner approval for the matching
+ * provider occurrence only. Broader-than-once decisions (session approval or an
+ * execution-policy amendment) are unsupported there and are declined instead of
+ * being widened, cached, or silently downconverted into an affirmative answer.
+ *
+ * Approval-shaped `requestUserInput` is a heuristic fallback for providers that
+ * did not use a typed native approval method. The pinned schema has no typed
+ * negative for it, so restricted mode rejects that shape with a fixed bounded
+ * unsupported error instead of guessing provider option labels.
+ *
+ * The helpers are inert unless the caller passes `requireExplicitOwnerDecision`,
+ * so the normal unrestricted path keeps its existing behaviour.
+ */
+
+export type BroaderThanOnceApprovalDecision =
+  | 'approved_for_session'
+  | 'approved_execpolicy_amendment';
+
+export function isBroaderThanOnceApproval(
+  decision: PermissionResult['decision'],
+): decision is BroaderThanOnceApprovalDecision {
+  return decision === 'approved_for_session' || decision === 'approved_execpolicy_amendment';
+}
+
+/** Narrows a broader permission result to a denial for the restricted profile. */
+export function restrictPermissionResultForExplicitOwner(params: Readonly<{
+  requireExplicitOwnerDecision: boolean;
+  requestKind: 'permission' | 'user_action';
+  result: PermissionResult;
+}>): PermissionResult {
+  if (!params.requireExplicitOwnerDecision) return params.result;
+  if (params.requestKind !== 'permission') return params.result;
+  if (!isBroaderThanOnceApproval(params.result.decision)) return params.result;
+  return { decision: 'denied' };
+}
+
+/** Declines a broader approval response; `null` means "use the stock mapping". */
+export function restrictedApprovalDecision(
+  requireExplicitOwnerDecision: boolean,
+  decision: PermissionResult['decision'],
+): Readonly<Record<string, unknown>> | null {
+  if (!requireExplicitOwnerDecision) return null;
+  return isBroaderThanOnceApproval(decision) ? { decision: 'decline' } : null;
+}
+
+/** Declines a native permissions (sandbox escalation) response in the restricted profile. */
+export function restrictedPermissionsDecision(
+  requireExplicitOwnerDecision: boolean,
+): Readonly<Record<string, unknown>> | null {
+  if (!requireExplicitOwnerDecision) return null;
+  return { permissions: {}, scope: 'turn' };
+}
+
+/** Declines a broader MCP elicitation acceptance; `null` means "use the stock mapping". */
+export function restrictedElicitationAction(
+  requireExplicitOwnerDecision: boolean,
+  decision: PermissionResult['decision'],
+): 'decline' | null {
+  if (!requireExplicitOwnerDecision) return null;
+  return isBroaderThanOnceApproval(decision) ? 'decline' : null;
+}
+
+export const RESTRICTED_APPROVAL_SHAPED_USER_INPUT_MESSAGE =
+  'restricted_deployment_requires_typed_approval';
+
+/**
+ * Fixed bounded error for a restricted approval-shaped `requestUserInput`.
+ *
+ * The app-server client converts a thrown handler error into a JSON-RPC error
+ * response (`{ id, error: { code: -32000, message } }`). Provider handling of
+ * that error is unqualified: it may fail the turn. It is not a denial and must
+ * not be treated as one.
+ */
+export function createRestrictedApprovalShapedUserInputError(): Error {
+  const error = new Error(RESTRICTED_APPROVAL_SHAPED_USER_INPUT_MESSAGE);
+  error.name = 'RestrictedApprovalShapedUserInputUnsupportedError';
+  return error;
+}
+
+/**
+ * True only for the restricted approval-shaped `requestUserInput` branch.
+ * Typed native approval methods are handled by their own mappings.
+ */
+export function isRestrictedApprovalShapedUserInput(params: Readonly<{
+  requireExplicitOwnerDecision: boolean;
+  method: string;
+  approvalShaped: boolean;
+}>): boolean {
+  return (
+    params.requireExplicitOwnerDecision === true &&
+    params.method === 'item/tool/requestUserInput' &&
+    params.approvalShaped === true
+  );
+}
+
+export const RESTRICTED_APPROVAL_OCCURRENCE_LIMIT = 4096;
+
+export type RestrictedApprovalOccurrenceRejection = 'settled' | 'full';
+
+/**
+ * Raised when a restricted permission request reuses a provider request id that
+ * this coordinator has already claimed. It is internal to the CLI; the Codex
+ * handler turns it into a typed denial so a stale id cannot become a new grant.
+ */
+export class RestrictedApprovalOccurrenceError extends Error {
+  readonly reason: RestrictedApprovalOccurrenceRejection;
+
+  constructor(reason: RestrictedApprovalOccurrenceRejection) {
+    super(`restricted_approval_occurrence_${reason}`);
+    this.name = 'RestrictedApprovalOccurrenceError';
+    this.reason = reason;
+  }
+}
+
+export type RestrictedSeenOccurrenceClaim = 'fresh' | 'duplicate' | 'full';
+
+export interface RestrictedSeenOccurrenceClaims {
+  claim(requestId: string): RestrictedSeenOccurrenceClaim;
+  has(requestId: string): boolean;
+  readonly size: number;
+}
+
+/**
+ * Bounded, non-evicting seen-id claim set.
+ *
+ * The claim is recorded before the owner prompt. A duplicate never grows the
+ * set. Once the capacity is reached, new ids are denied rather than evicting an
+ * older id (eviction would permit reuse of a settled identity).
+ */
+export function createBoundedSeenOccurrenceClaims(
+  capacity: number,
+): RestrictedSeenOccurrenceClaims {
+  if (!Number.isSafeInteger(capacity) || capacity <= 0) {
+    throw new Error('restricted_approval_occurrence_limit_invalid');
+  }
+  const seen = new Set<string>();
+  return {
+    claim(requestId: string): RestrictedSeenOccurrenceClaim {
+      if (seen.has(requestId)) return 'duplicate';
+      if (seen.size >= capacity) return 'full';
+      seen.add(requestId);
+      return 'fresh';
+    },
+    has(requestId: string): boolean {
+      return seen.has(requestId);
+    },
+    get size(): number {
+      return seen.size;
+    },
+  };
+}
