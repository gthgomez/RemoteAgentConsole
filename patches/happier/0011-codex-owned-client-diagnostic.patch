diff --git a/apps/cli/src/backends/codex/utils/restrictedCodexLaunch.ts b/apps/cli/src/backends/codex/utils/restrictedCodexLaunch.ts
new file mode 100644
index 0000000000000000000000000000000000000000..82cd3809650c01d35262be18ea6db40a79d2cf11
--- /dev/null
+++ b/apps/cli/src/backends/codex/utils/restrictedCodexLaunch.ts
@@ -0,0 +1,10 @@
+import { isRestrictedDeploymentConfigured } from '@/security/restrictedDeployment/policy';
+
+/** A narrowed child environment must not clear the host's restricted mode. */
+export function requiresOwnedCodexLaunch(env?: NodeJS.ProcessEnv): boolean {
+    return isRestrictedDeploymentConfigured() || (env !== undefined && isRestrictedDeploymentConfigured(env));
+}
+
+export function assertUnownedCodexLaunchAllowed(env?: NodeJS.ProcessEnv): void {
+    if (requiresOwnedCodexLaunch(env)) throw new Error('restricted_codex_owner_required');
+}
