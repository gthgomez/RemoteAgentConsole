@@ -0,0 +1,45 @@
+import type { IncomingHttpHeaders } from "node:http";
+
+import { readRestrictedDeviceAuthority } from "@/app/auth/restrictedDeviceGrants";
+import type { Fastify } from "../types";
+
+export const RESTRICTED_RELAY_HOST = "127.0.0.1";
+
+export type RestrictedRelayIngress = Readonly<{
+    origin: string;
+    allows: (headers: IncomingHttpHeaders) => boolean;
+}>;
+
+export function readRestrictedRelayIngress(env: NodeJS.ProcessEnv): RestrictedRelayIngress | undefined {
+    if (readRestrictedDeviceAuthority(env) === null) return undefined;
+    const origin = env.HAPPIER_RAC_PUBLIC_ORIGIN?.trim() ?? "";
+    const parsed = origin.length <= 512 ? URL.parse(origin) : null;
+    if (!parsed || parsed.protocol !== "https:" || parsed.origin !== origin) {
+        throw new Error("Restricted relay requires one private HTTPS origin without a path");
+    }
+    const port = Number(env.PORT ?? "3005");
+    if (!/^\d{1,5}$/.test(env.PORT ?? "3005") || port < 1 || port > 65_535) {
+        throw new Error("Restricted relay requires a valid local port");
+    }
+    const loopbackAuthority = port === 80 ? RESTRICTED_RELAY_HOST : `${RESTRICTED_RELAY_HOST}:${port}`;
+    const allowedHosts = new Set([parsed.host, loopbackAuthority]);
+    return {
+        origin,
+        allows: ({ host, origin: requestOrigin }) => (
+            typeof host === "string"
+            && allowedHosts.has(host.toLowerCase())
+            && (requestOrigin === undefined || requestOrigin === origin)
+        ),
+    };
+}
+
+export function enableRestrictedRelayHttpIngress(
+    app: Pick<Fastify, "addHook">,
+    ingress: RestrictedRelayIngress,
+): void {
+    app.addHook("onRequest", async (request, reply) => {
+        if (!ingress.allows(request.raw.headers)) {
+            return reply.code(403).send({ error: "untrusted-relay-request" });
+        }
+    });
+}
