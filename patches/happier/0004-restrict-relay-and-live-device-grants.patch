index 00000000..b02ad76a
--- /dev/null
+++ b/apps/server/sources/app/api/socket/bindRestrictedSocketGrant.ts
@@ -0,0 +1,37 @@
+import type { Socket } from "socket.io";
+
+const GRANT_RECHECK_INTERVAL_MS = 5_000;
+const GRANT_CHECK_TIMEOUT_MS = 2_000;
+
+export function bindRestrictedSocketGrant(socket: Socket, isCurrent: () => Promise<boolean>): void {
+    let pendingCheck: Promise<boolean> | undefined;
+
+    function check(): Promise<boolean> {
+        if (pendingCheck) return pendingCheck;
+
+        let deadline: NodeJS.Timeout;
+        const expired = new Promise<boolean>(resolve => {
+            deadline = setTimeout(() => resolve(false), GRANT_CHECK_TIMEOUT_MS);
+            deadline.unref();
+        });
+        pendingCheck = Promise.race([Promise.resolve().then(isCurrent), expired])
+            .catch(() => false)
+            .then(current => {
+                if (!current) socket.disconnect(true);
+                return current && socket.connected;
+            })
+            .finally(() => {
+                clearTimeout(deadline);
+                pendingCheck = undefined;
+            });
+        return pendingCheck;
+    }
+
+    // Incoming messages must not wait for the idle connection sweep to observe revocation.
+    socket.use((_packet, next) => {
+        void check().then(current => next(current ? undefined : new Error("invalid-device-grant")));
+    });
+    const sweep = setInterval(() => void check(), GRANT_RECHECK_INTERVAL_MS);
+    sweep.unref();
+    socket.once("disconnect", () => clearInterval(sweep));
+}
