+import { createHmac, randomUUID } from "node:crypto";
+import Fastify from "fastify";
+import { SOCKET_RPC_EVENTS } from "@happier-dev/protocol/socketRpc";
+import { createPersistentTokenGenerator } from "privacy-kit";
+import { io as ioClient } from "socket.io-client";
+import { afterAll, beforeAll, expect, it } from "vitest";
+
+import { db } from "@/storage/db";
+import { auth } from "@/app/auth/auth";
+import { createLightSqliteHarness, type LightSqliteHarness } from "@/testkit/lightSqliteHarness";
+import { startSocket } from "./socket";
+import type { Fastify as AppFastify } from "./types";
+import { readRestrictedRelayIngress } from "./utils/restrictedRelayIngress";
+
+const incarnation = "ca3f8c09-6cca-4042-a47a-978a8c2950ac";
+const fixtureSecret = Buffer.alloc(32, 11).toString("base64url");
+const publicOrigin = "https://rac-fixture.example";
+let harness: LightSqliteHarness;
+
+beforeAll(async () => {
+    harness = await createLightSqliteHarness({
+        tempDirPrefix: "happier-restricted-socket-",
+        initAuth: true,
+        env: {
+            HANDY_MASTER_SECRET: fixtureSecret,
+            HAPPIER_RAC_RESTRICTED_DEPLOYMENT: "1",
+            HAPPIER_RAC_AUTH_INCARNATION: incarnation,
+            HAPPIER_RAC_PUBLIC_ORIGIN: publicOrigin,
+        },
+    });
+}, 120_000);
+
+afterAll(async () => {
+    await harness?.close();
+});
+
+it("rejects phone publisher claims and disconnects only the revoked phone's live connections", async () => {
+    const account = await db.account.create({ data: { publicKey: randomUUID() } });
+    const machineId = randomUUID();
+    await db.machine.create({
+        data: { id: machineId, accountId: account.id, metadata: "fixture", metadataVersion: 1 },
+    });
+    const generator = await createPersistentTokenGenerator({
+        service: "handy",
+        seed: createHmac("sha256", fixtureSecret).update(`rac-device-authority-v1:${incarnation}`).digest("base64url"),
+    });
+    async function grantToken(kind: "phone" | "host") {
+        const grant = await db.restrictedDeviceGrant.create({
+            data: { accountId: account.id, authorityIncarnation: incarnation, kind },
+        });
+        const issuedAtMs = Date.now();
+        return {
+            id: grant.id,
+            token: await generator.new({
+                user: account.id,
+                extras: {
+                    format: "restricted-device-v1",
+                    authorityIncarnation: incarnation,
+                    accountId: account.id,
+                    grantId: grant.id,
+                    grantGeneration: grant.generation,
+                    kind,
+                    issuedAtMs,
+                    expiresAtMs: issuedAtMs + 60_000,
+                },
+            }),
+        };
+    }
+    const lost = await grantToken("phone");
+    const other = await grantToken("phone");
+    const host = await grantToken("host");
+    for (const grant of [lost, other, host]) {
+        await expect(auth.verifyToken(grant.token)).resolves.toMatchObject({ deviceGrant: { grantId: grant.id } });
+    }
+    const app = Fastify({ logger: false }) as unknown as AppFastify;
+    const address = await app.listen({ host: "127.0.0.1", port: 0 });
+    startSocket(app, readRestrictedRelayIngress({ ...process.env, PORT: new URL(address).port }));
+    const sockets: Array<ReturnType<typeof ioClient>> = [];
+
+    function socketClient(auth: Record<string, unknown>, extraHeaders?: Record<string, string>) {
+        const socket = ioClient(address, {
+            path: "/v1/updates", autoConnect: false, reconnection: false, forceNew: true,
+            transports: ["websocket"], auth, extraHeaders,
+        });
+        sockets.push(socket);
+        return socket;
+    }
+
+    async function connect(socket: ReturnType<typeof ioClient>) {
+        await new Promise<void>((resolve, reject) => {
+            socket.once("connect", resolve);
+            socket.once("connect_error", reject);
+            socket.connect();
+        });
+    }
+
+    try {
+        const outsideOrigin = socketClient({ token: lost.token }, { Origin: "https://outside.example" });
+        await expect(connect(outsideOrigin)).rejects.toMatchObject({ message: "websocket error" });
+        const impostor = socketClient({ token: lost.token, machineId, clientType: "machine-scoped", takeover: true });
+        await expect(connect(impostor)).rejects.toMatchObject({ message: "device-scope-denied" });
+        const sessionImpostor = socketClient({ token: lost.token, sessionId: randomUUID(), clientType: "session-scoped" });
+        await expect(connect(sessionImpostor)).rejects.toMatchObject({ message: "device-scope-denied" });
+        const publisher = socketClient({ token: host.token, machineId, clientType: "machine-scoped" });
+        const sender = socketClient({ token: lost.token, deviceGrant: { grantId: other.id } });
+        const idle = socketClient({ token: lost.token });
+        const retained = socketClient({ token: other.token }, { Origin: publicOrigin });
+        await expect(connect(publisher), "host publisher").resolves.toBeUndefined();
+        await expect(connect(sender), "phone sender").resolves.toBeUndefined();
+        await expect(connect(idle), "idle socket for the same phone").resolves.toBeUndefined();
+        await expect(connect(retained), "other phone on the trusted origin").resolves.toBeUndefined();
+        await expect(sender.timeout(1_000).emitWithAck("ping")).resolves.toEqual({});
+
+        const method = `${machineId}:fixture.read`;
+        function register(socket: ReturnType<typeof ioClient>) {
+            return new Promise<unknown>(resolve => {
+                socket.once(SOCKET_RPC_EVENTS.REGISTERED, resolve);
+                socket.once(SOCKET_RPC_EVENTS.ERROR, resolve);
+                socket.emit(SOCKET_RPC_EVENTS.REGISTER, { method });
+            });
+        }
+        await expect(register(publisher)).resolves.toEqual({ method });
+        await expect(register(sender)).resolves.toEqual({ type: "register", error: "Forbidden" });
+
+        const closed = [sender, idle].map(socket => new Promise<string>(resolve => socket.once("disconnect", resolve)));
+        await db.restrictedDeviceGrant.update({
+            where: { id: lost.id }, data: { revokedAt: new Date(), generation: { increment: 1 } },
+        });
+        await expect(sender.timeout(1_000).emitWithAck("ping")).rejects.toThrow();
+        await expect(Promise.all(closed)).resolves.toEqual(["io server disconnect", "io server disconnect"]);
+        await expect(connect(socketClient({ token: lost.token }))).rejects.toMatchObject({ message: "invalid-token" });
+        await expect(retained.timeout(1_000).emitWithAck("ping")).resolves.toEqual({});
+        await expect(publisher.timeout(1_000).emitWithAck("ping")).resolves.toEqual({});
+    } finally {
+        for (const socket of sockets) socket.close();
+        await app.close();
+    }
+}, 20_000);
