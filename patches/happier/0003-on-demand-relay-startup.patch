diff --git a/packages/cli-common/src/relayHost/relayHostEngine.localPersistence.test.ts b/packages/cli-common/src/relayHost/relayHostEngine.localPersistence.test.ts
new file mode 100644
index 00000000..ba68cf3e
--- /dev/null
+++ b/packages/cli-common/src/relayHost/relayHostEngine.localPersistence.test.ts
@@ -0,0 +1,82 @@
+import { mkdtemp, mkdir, rm, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+describe('RelayHostEngine local startup persistence', () => {
+  const originalPlatform = process.platform;
+
+  afterEach(() => {
+    Object.defineProperty(process, 'platform', { value: originalPlatform });
+    vi.resetModules();
+    vi.doUnmock('node:os');
+    vi.doUnmock('node:child_process');
+    vi.doUnmock('../service/index.js');
+  });
+
+  it('passes on-demand installation through the maintained service plan without an enable action', async () => {
+    const homeDir = await mkdtemp(join(tmpdir(), 'relay-host-on-demand-'));
+    const payloadRoot = join(homeDir, 'payload');
+    const plans: Array<{ commands: readonly { cmd: string; args: readonly string[] }[] }> = [];
+    try {
+      await mkdir(join(payloadRoot, 'bin', 'prisma', 'sqlite', 'migrations'), { recursive: true });
+      await writeFile(join(payloadRoot, 'bin', 'happier-server'), '#!/bin/sh\nexit 0\n', 'utf8');
+
+      Object.defineProperty(process, 'platform', { value: 'linux' });
+      vi.doMock('node:os', async () => {
+        const actual = await vi.importActual<typeof import('node:os')>('node:os');
+        return { ...actual, homedir: () => homeDir };
+      });
+      vi.doMock('node:child_process', async () => {
+        const actual = await vi.importActual<typeof import('node:child_process')>('node:child_process');
+        return {
+          ...actual,
+          spawnSync: (cmd: string, args?: readonly string[]) => {
+            if (cmd === 'systemctl' && Array.isArray(args) && args.includes('show')) {
+              return { status: 0, stdout: 'LoadState=not-found\nActiveState=inactive\nSubState=dead\nUnitFileState=\n', stderr: '' };
+            }
+            return { status: 0, stdout: '', stderr: '' };
+          },
+        };
+      });
+      vi.doMock('../service/index.js', async (importOriginal) => {
+        const actual = await importOriginal<typeof import('../service/index.js')>();
+        return {
+          ...actual,
+          applyServicePlan: async (plan: { commands: readonly { cmd: string; args: readonly string[] }[] }) => {
+            plans.push(plan);
+          },
+        };
+      });
+
+      const { createRelayHostEngine } = await import('./relayHostEngine.js');
+      const engine = createRelayHostEngine({
+        localInstallPolicy: {
+          persistent: false,
+          runServiceCommands: false,
+          skipHealthCheck: true,
+        },
+        resolveRemoteReleaseTarget: async () => ({ os: 'linux', arch: 'x64' }),
+        runRemoteText: async () => ({ status: 0, stdout: '', stderr: '' }),
+        copyLocalDirectoryToRemote: async () => {},
+        installRemoteComponent: async () => ({ binaryPath: '', versionId: 'fixture' }),
+      });
+
+      await engine.installOrUpdate({
+        target: { kind: 'local' },
+        channel: 'stable',
+        mode: 'user',
+        env: { RUN_MIGRATIONS: '0' },
+        selfHostRelayBinaryOverride: join(payloadRoot, 'bin', 'happier-server'),
+      });
+
+      const installPlan = plans.find((plan) => plan.commands.some((command) => command.args.includes('restart')));
+      expect(installPlan).toBeDefined();
+      expect(installPlan?.commands.some((command) => command.cmd === 'systemctl' && command.args.includes('enable'))).toBe(false);
+      expect(installPlan?.commands.some((command) => command.cmd === 'systemctl' && command.args.includes('restart'))).toBe(true);
+    } finally {
+      await rm(homeDir, { recursive: true, force: true });
+    }
+  });
+});
