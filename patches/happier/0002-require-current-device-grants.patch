diff --git a/apps/server/sources/app/auth/restrictedDeviceGrants.test.ts b/apps/server/sources/app/auth/restrictedDeviceGrants.test.ts
new file mode 100644
index 00000000..72d19a6c
--- /dev/null
+++ b/apps/server/sources/app/auth/restrictedDeviceGrants.test.ts
@@ -0,0 +1,92 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+import { readRestrictedDeviceAuthority, verifyRestrictedDeviceGrant } from './restrictedDeviceGrants';
+
+const authorityIncarnation = 'ca3f8c09-6cca-4042-a47a-978a8c2950ac';
+const replacementIncarnation = '3a8f4d42-2b8e-4fff-8bd2-2fc44d6655c9';
+const fixtureGrant = {
+    id: 'fixture-grant',
+    accountId: 'fixture-account',
+    authorityIncarnation,
+    kind: 'phone',
+    generation: 2,
+    createdAt: new Date(1_000),
+    revokedAt: null,
+};
+const fixtureClaim = {
+    format: 'restricted-device-v1',
+    authorityIncarnation,
+    accountId: fixtureGrant.accountId,
+    grantId: fixtureGrant.id,
+    grantGeneration: fixtureGrant.generation,
+    kind: 'phone',
+    issuedAtMs: 2_000,
+    expiresAtMs: 5_000,
+};
+
+describe('restricted device grant authorization', () => {
+    afterEach(() => vi.unstubAllEnvs());
+
+    it('requires configured local authority before activating restricted authentication', () => {
+        expect(readRestrictedDeviceAuthority({})).toBeNull();
+        expect(() => readRestrictedDeviceAuthority({ HAPPIER_RAC_RESTRICTED_DEPLOYMENT: '1' })).toThrow();
+        expect(() => readRestrictedDeviceAuthority({ HAPPIER_RAC_AUTH_INCARNATION: authorityIncarnation })).toThrow();
+        expect(readRestrictedDeviceAuthority({
+            HAPPIER_RAC_RESTRICTED_DEPLOYMENT: '1', HAPPIER_RAC_AUTH_INCARNATION: authorityIncarnation,
+        })).toBe(authorityIncarnation);
+    });
+
+    it('looks up the current grant on every verification and denies revoked authority', async () => {
+        const lookupGrant = vi.fn()
+            .mockResolvedValueOnce(fixtureGrant)
+            .mockResolvedValueOnce({ ...fixtureGrant, revokedAt: new Date(3_100), generation: 3 });
+        const verification = {
+            authorityIncarnation, userId: fixtureGrant.accountId, signedExtras: fixtureClaim, nowMs: 3_200, lookupGrant,
+        };
+        await expect(verifyRestrictedDeviceGrant(verification)).resolves.toMatchObject({ grantId: fixtureGrant.id, kind: 'phone' });
+        await expect(verifyRestrictedDeviceGrant(verification)).resolves.toBeNull();
+        expect(lookupGrant).toHaveBeenCalledTimes(2);
+    });
+
+    it('rejects legacy, mismatched, expired and pre-restore claims before grant lookup', async () => {
+        const lookupGrant = vi.fn().mockResolvedValue(fixtureGrant);
+        const verification = {
+            authorityIncarnation, userId: fixtureGrant.accountId, signedExtras: fixtureClaim, nowMs: 3_000, lookupGrant,
+        };
+        await expect(verifyRestrictedDeviceGrant({ ...verification, signedExtras: null })).resolves.toBeNull();
+        await expect(verifyRestrictedDeviceGrant({ ...verification, userId: 'other-account' })).resolves.toBeNull();
+        await expect(verifyRestrictedDeviceGrant({ ...verification, nowMs: fixtureClaim.expiresAtMs })).resolves.toBeNull();
+        await expect(verifyRestrictedDeviceGrant({ ...verification, authorityIncarnation: replacementIncarnation })).resolves.toBeNull();
+        expect(lookupGrant).not.toHaveBeenCalled();
+    });
+
+    it('denies stale generations, substituted grants and unavailable authority storage', async () => {
+        const verification = { authorityIncarnation, userId: fixtureGrant.accountId, signedExtras: fixtureClaim, nowMs: 3_000 };
+        for (const current of [null, { ...fixtureGrant, generation: 3 }, { ...fixtureGrant, kind: 'host' },
+            { ...fixtureGrant, accountId: 'other-account' }, { ...fixtureGrant, createdAt: new Date(2_100) }]) {
+            await expect(verifyRestrictedDeviceGrant({ ...verification, lookupGrant: async () => current })).resolves.toBeNull();
+        }
+        await expect(verifyRestrictedDeviceGrant({
+            ...verification, lookupGrant: async () => { throw new Error('fixture storage unavailable'); },
+        })).resolves.toBeNull();
+    });
+
+    it('rejects a previously valid legacy bearer and legacy issuance on the maintained auth entry points', async () => {
+        vi.stubEnv('HANDY_MASTER_SECRET', Buffer.alloc(32, 7).toString('base64url'));
+        vi.stubEnv('HAPPIER_RAC_RESTRICTED_DEPLOYMENT', undefined);
+        vi.stubEnv('HAPPIER_RAC_AUTH_INCARNATION', undefined);
+        vi.resetModules();
+        const { auth: priorAuth } = await import('./auth');
+        await priorAuth.init();
+        const legacy = await priorAuth.createToken(fixtureGrant.accountId);
+        await expect(priorAuth.verifyToken(legacy)).resolves.toMatchObject({ userId: fixtureGrant.accountId });
+
+        vi.stubEnv('HAPPIER_RAC_RESTRICTED_DEPLOYMENT', '1');
+        vi.stubEnv('HAPPIER_RAC_AUTH_INCARNATION', authorityIncarnation);
+        vi.resetModules();
+        const { auth: restrictedAuth } = await import('./auth');
+        await restrictedAuth.init();
+        await expect(restrictedAuth.verifyToken(legacy)).resolves.toBeNull();
+        await expect(restrictedAuth.createToken(fixtureGrant.accountId)).rejects.toThrow('local device enrollment');
+    });
+});
diff --git a/apps/server/sources/app/auth/restrictedDeviceGrants.ts b/apps/server/sources/app/auth/restrictedDeviceGrants.ts
new file mode 100644
index 00000000..815d12ef
--- /dev/null
+++ b/apps/server/sources/app/auth/restrictedDeviceGrants.ts
@@ -0,0 +1,67 @@
+import { z } from 'zod';
+
+const authorityIdSchema = z.uuid();
+const deviceKindSchema = z.enum(['phone', 'host']);
+const grantClaimsSchema = z.strictObject({
+    format: z.literal('restricted-device-v1'),
+    authorityIncarnation: authorityIdSchema,
+    accountId: z.string().min(1).max(256),
+    grantId: z.string().min(1).max(256),
+    grantGeneration: z.number().int().min(1).max(2_147_483_647),
+    kind: deviceKindSchema,
+    issuedAtMs: z.number().int().nonnegative(),
+    expiresAtMs: z.number().int().positive(),
+});
+
+type DeviceGrantSnapshot = Readonly<{
+    id: string;
+    accountId: string;
+    authorityIncarnation: string;
+    kind: string;
+    generation: number;
+    createdAt: Date;
+    revokedAt: Date | null;
+}>;
+
+export type RestrictedDeviceContext = Readonly<{
+    grantId: string;
+    generation: number;
+    kind: z.infer<typeof deviceKindSchema>;
+}>;
+
+/** The installer supplies the current authority incarnation independently of restored session data. */
+export function readRestrictedDeviceAuthority(env: NodeJS.ProcessEnv): string | null {
+    const mode = env.HAPPIER_RAC_RESTRICTED_DEPLOYMENT;
+    const incarnation = env.HAPPIER_RAC_AUTH_INCARNATION;
+    if (mode === undefined && incarnation === undefined) return null;
+    const parsed = authorityIdSchema.safeParse(incarnation);
+    if (mode !== '1' || !parsed.success) throw new Error('Restricted device authority is not configured');
+    return parsed.data;
+}
+
+/** Accept signed claims only while the matching durable grant is current. */
+export async function verifyRestrictedDeviceGrant(params: Readonly<{
+    authorityIncarnation: string;
+    userId: string;
+    signedExtras: unknown;
+    nowMs: number;
+    lookupGrant: (id: string) => Promise<DeviceGrantSnapshot | null>;
+}>): Promise<RestrictedDeviceContext | null> {
+    const parsed = grantClaimsSchema.safeParse(params.signedExtras);
+    if (!parsed.success) return null;
+    const claims = parsed.data;
+    if (claims.accountId !== params.userId || claims.authorityIncarnation !== params.authorityIncarnation
+        || claims.issuedAtMs > params.nowMs || claims.expiresAtMs <= params.nowMs
+        || claims.expiresAtMs <= claims.issuedAtMs) return null;
+
+    try {
+        const grant = await params.lookupGrant(claims.grantId);
+        if (!grant || grant.id !== claims.grantId || grant.accountId !== params.userId
+            || grant.authorityIncarnation !== params.authorityIncarnation || grant.revokedAt !== null
+            || grant.generation !== claims.grantGeneration || grant.kind !== claims.kind
+            || !(grant.createdAt.getTime() <= claims.issuedAtMs)) return null;
+        return { grantId: grant.id, generation: grant.generation, kind: claims.kind };
+    } catch {
+        return null;
+    }
+}
