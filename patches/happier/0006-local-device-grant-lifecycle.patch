+            .resolves.toBe(false);
+        const previousIncarnation = createRestrictedDeviceAuthority({
+            authorityIncarnation: replacementIncarnation,
+            store: foreign.store,
+            clock: foreign.clock,
+        });
+        await expect(previousIncarnation.revokeGrant({ accountId, grantId: foreignGrant.grant.grantId }))
+            .resolves.toBe(false);
+        expect(foreign.grants[0]!.revokedAt).toBeNull();
+    });
+
+    it('shares the strict claim parser and date bound between issuer and verifier', async () => {
+        const ctx = setup();
+        const { grant } = await enrollAndRedeem(ctx);
+        const claims = await ctx.authority.buildGrantClaims({ accountId, grantId: grant.grantId });
+
+        expect(parseRestrictedDeviceGrantClaims(claims)).toEqual(claims);
+        expect(areRestrictedDeviceClaimTimesUsable(claims, startMs)).toBe(true);
+        expect(parseRestrictedDeviceGrantClaims({ ...claims, extra: true })).toBeNull();
+        expect(parseRestrictedDeviceGrantClaims({
+            ...claims,
+            authorityIncarnation: '00000000-0000-0000-0000-000000000000',
+        })).toBeNull();
+        expect(parseRestrictedDeviceGrantClaims({ ...claims, accountId: '' })).toBeNull();
+        expect(parseRestrictedDeviceGrantClaims({ ...claims, grantGeneration: 0 })).toBeNull();
+        expect(parseRestrictedDeviceGrantClaims({ ...claims, kind: 'tablet' })).toBeNull();
+        expect(areRestrictedDeviceClaimTimesUsable({
+            issuedAtMs: startMs,
+            expiresAtMs: startMs + MAX_DEVICE_CLAIM_LIFETIME_MS + 1,
+        }, startMs)).toBe(false);
+        expect(areRestrictedDeviceClaimTimesUsable({ issuedAtMs: startMs, expiresAtMs: startMs }, startMs)).toBe(false);
+        await expect(ctx.authority.buildGrantClaims({
