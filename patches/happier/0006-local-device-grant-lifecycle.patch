+    });
+
+    it('fails closed after a committed grant loses its response and supports owner recovery', async () => {
+        const ctx = setup();
+        const enrollment = await ctx.authority.createEnrollment({ accountId, kind: 'phone' });
+        const committed = await redeem(ctx, enrollment.secret);
+
+        // The client retries because the response was lost. The durable grant
+        // already exists; the retry must not replay or mint a second one.
+        await expect(redeem(ctx, enrollment.secret)).rejects.toMatchObject({ code: 'enrollment-not-usable' });
+        expect(ctx.grants).toHaveLength(1);
+
+        const recovery = await ctx.authority.readEnrollmentRecovery({
+            accountId,
+            enrollmentId: enrollment.enrollmentId,
+        });
+        expect(recovery).toMatchObject({
+            enrollmentId: enrollment.enrollmentId,
