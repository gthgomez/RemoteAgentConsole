+        await expect(redeem(ctx, hostEnrollment.secret, 'host')).resolves
+            .toMatchObject({ kind: 'host' });
+        expect(ctx.grants[0]!.kind).toBe('host');
+
+        const phoneEnrollment = await ctx.authority.createEnrollment({ accountId, kind: 'phone' });
