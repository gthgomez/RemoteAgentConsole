@@ -0,0 +1,289 @@
+import {
+    isBoundedRestrictedDeviceIdentifier,
+    isRestrictedDeviceKind,
+    type RestrictedDeviceGrantClaims,
+    type RestrictedDeviceKind,
+} from './restrictedDeviceClaimsContract';
+import {
+    RestrictedDeviceGrantLifecycleError,
+    buildRestrictedDeviceGrantClaims,
+    createPendingEnrollment,
+    readRestrictedDeviceGrantStatus,
+    redeemPendingEnrollment,
+    requireRestrictedDeviceAuthorityIncarnation,
+    revokeRestrictedDeviceGrant,
+    type RestrictedDeviceEnrollmentRecord,
+    type RestrictedDeviceGrantRecord,
+    type RestrictedDeviceGrantStatus,
+} from './restrictedDeviceEnrollment';
+
+export const MAX_PENDING_ENROLLMENTS_PER_ACCOUNT = 5;
+export const DEFAULT_ENROLLMENT_RECOVERY_LIMIT = 10;
+export const MAX_ENROLLMENT_RECOVERY_LIMIT = 50;
+export const DEFAULT_ENROLLMENT_CLEANUP_LIMIT = 50;
+export const MAX_ENROLLMENT_CLEANUP_LIMIT = 500;
+
+export type RecoveryEnrollmentRow = Readonly<{
+    id: string;
+    accountId: string;
+    authorityIncarnation: string;
+    kind: string;
+    createdAt: Date;
+    expiresAt: Date;
+    consumedAt: Date | null;
+    redeemedGrantId: string | null;
+    grant: RestrictedDeviceGrantRecord | null;
+}>;
+
+export type RedactedEnrollmentRecovery = Readonly<{
+    enrollmentId: string;
+    kind: string;
+    state: 'pending' | 'redeemed' | 'expired' | 'incomplete';
+    createdAt: Date;
+    expiresAt: Date;
+    consumedAt: Date | null;
+    grant: Readonly<{
+        grantId: string;
+        generation: number;
+        createdAt: Date;
+        revokedAt: Date | null;
+    }> | null;
+}>;
+
+export type RestrictedDeviceAuthorityStore = Readonly<{
+    createEnrollment(input: Readonly<{
+        record: RestrictedDeviceEnrollmentRecord;
+        maxPending: number;
+        clock: () => Date;
+    }>): Promise<Readonly<{ id: string; expiresAt: Date }>>;
+    redeemEnrollment(input: Readonly<{
+        secretHash: string;
+        accountId: string;
+        authorityIncarnation: string;
+        expectedKind: RestrictedDeviceKind;
+        clock: () => Date;
+    }>): Promise<Readonly<{ grantId: string; generation: number; kind: string }> | null>;
+    findGrant(id: string): Promise<RestrictedDeviceGrantRecord | null>;
+    findEnrollment(input: Readonly<{
+        id: string;
+        accountId: string;
+        authorityIncarnation: string;
+    }>): Promise<RecoveryEnrollmentRow | null>;
+    listEnrollments(input: Readonly<{
+        accountId: string;
+        authorityIncarnation: string;
+        limit: number;
+    }>): Promise<ReadonlyArray<RecoveryEnrollmentRow>>;
+    revokeGrantConditionally(input: Readonly<{
+        accountId: string;
+        authorityIncarnation: string;
+        grantId: string;
+        now: Date;
+    }>): Promise<number>;
+    deleteExpiredUnusedEnrollments(input: Readonly<{
+        authorityIncarnation: string;
+        now: Date;
+        limit: number;
+    }>): Promise<number>;
+}>;
+
+export type RestrictedDeviceAuthority = Readonly<{
+    createEnrollment(input: Readonly<{
+        accountId: string;
+        kind: RestrictedDeviceKind;
+        ttlMs?: number;
+    }>): Promise<Readonly<{ enrollmentId: string; secret: string; expiresAt: Date }>>;
+    redeemEnrollment(input: Readonly<{
+        accountId: string;
+        secret: string;
+        expectedKind: RestrictedDeviceKind;
+    }>): Promise<Readonly<{ grantId: string; generation: number; kind: RestrictedDeviceKind }>>;
+    readEnrollmentRecovery(input: Readonly<{
+        accountId: string;
+        enrollmentId: string;
+    }>): Promise<RedactedEnrollmentRecovery | null>;
+    listRecentEnrollments(input: Readonly<{
+        accountId: string;
+        limit?: number;
+    }>): Promise<ReadonlyArray<RedactedEnrollmentRecovery>>;
+    readGrantStatus(input: Readonly<{ accountId: string; grantId: string }>): Promise<RestrictedDeviceGrantStatus>;
+    revokeGrant(input: Readonly<{ accountId: string; grantId: string }>): Promise<boolean>;
+    buildGrantClaims(input: Readonly<{
+        accountId: string;
+        grantId: string;
+        tokenTtlMs?: number;
+    }>): Promise<RestrictedDeviceGrantClaims>;
+    cleanupExpiredEnrollments(input?: Readonly<{ limit?: number }>): Promise<number>;
+}>;
+
+function readClock(clock: () => Date): Date {
+    const now = clock();
+    if (!(now instanceof Date) || !Number.isFinite(now.getTime())) {
+        throw new RestrictedDeviceGrantLifecycleError('invalid-request', 'Device authority clock is not usable');
+    }
+    return now;
+}
+
+function readLimit(value: unknown, fallback: number, maximum: number, label: string): number {
+    const limit = value === undefined ? fallback : value;
+    if (typeof limit !== 'number' || !Number.isSafeInteger(limit) || limit < 1 || limit > maximum) {
+        throw new RestrictedDeviceGrantLifecycleError(
+            'invalid-request',
+            `${label} must be between 1 and ${maximum}`,
+        );
+    }
+    return limit;
+}
+
+function toRecovery(row: RecoveryEnrollmentRow, now: Date): RedactedEnrollmentRecovery {
+    const grant = row.grant
+        && row.grant.accountId === row.accountId
+        && row.grant.authorityIncarnation === row.authorityIncarnation
+        ? row.grant
+        : null;
+    const consistentKind = isRestrictedDeviceKind(row.kind);
+    const consumed = row.consumedAt !== null;
+    const inconsistent = !consistentKind
+        || (consumed && (grant === null || row.redeemedGrantId === null))
+        || (!consumed && (grant !== null || row.redeemedGrantId !== null));
+    const state: RedactedEnrollmentRecovery['state'] = inconsistent
+        ? 'incomplete'
+        : consumed
+            ? 'redeemed'
+            : row.expiresAt.getTime() <= now.getTime()
+                ? 'expired'
+                : 'pending';
+    return {
+        enrollmentId: row.id,
+        kind: row.kind,
+        state,
+        createdAt: row.createdAt,
+        expiresAt: row.expiresAt,
+        consumedAt: row.consumedAt,
+        grant: grant
+            ? {
+                grantId: grant.id,
+                generation: grant.generation,
+                createdAt: grant.createdAt,
+                revokedAt: grant.revokedAt,
+            }
+            : null,
+    };
+}
+
+/**
+ * Bind one captured issuer incarnation to the persistence layer. Production
+ * callers construct this during server init and never accept an incarnation
+ * from request data. Redemption always carries the ingress-authorized expected
+ * kind; the store applies it inside the atomic claim and checks expiry at
+ * transaction admission.
+ */
+export function createRestrictedDeviceAuthority(options: Readonly<{
+    authorityIncarnation: string;
+    store: RestrictedDeviceAuthorityStore;
+    clock?: () => Date;
+}>): RestrictedDeviceAuthority {
+    const authorityIncarnation = requireRestrictedDeviceAuthorityIncarnation(options.authorityIncarnation);
+    const store = options.store;
+    const clock = options.clock ?? (() => new Date());
+
+    return {
+        async createEnrollment(input) {
+            const proposedAt = readClock(clock);
+            const pending = createPendingEnrollment({
+                accountId: input.accountId,
+                authorityIncarnation,
+                kind: input.kind,
+                nowMs: proposedAt.getTime(),
+                ttlMs: input.ttlMs,
+            });
+            const created = await store.createEnrollment({
+                record: pending.record,
+                maxPending: MAX_PENDING_ENROLLMENTS_PER_ACCOUNT,
+                clock,
+            });
+            return { enrollmentId: created.id, secret: pending.secret, expiresAt: created.expiresAt };
+        },
+
+        async redeemEnrollment(input) {
+            return await redeemPendingEnrollment({
+                accountId: input.accountId,
+                authorityIncarnation,
+                secret: input.secret,
+                expectedKind: input.expectedKind,
+                redeemAtomically: async claim => await store.redeemEnrollment({ ...claim, clock }),
+            });
+        },
+
+        async readEnrollmentRecovery(input) {
+            if (!isBoundedRestrictedDeviceIdentifier(input.enrollmentId)) {
+                throw new RestrictedDeviceGrantLifecycleError('invalid-request', 'Device enrollment id is not usable');
+            }
+            const row = await store.findEnrollment({
+                id: input.enrollmentId,
+                accountId: input.accountId,
+                authorityIncarnation,
+            });
+            return row ? toRecovery(row, readClock(clock)) : null;
+        },
+
+        async listRecentEnrollments(input) {
+            const rows = await store.listEnrollments({
+                accountId: input.accountId,
+                authorityIncarnation,
+                limit: readLimit(
+                    input.limit,
+                    DEFAULT_ENROLLMENT_RECOVERY_LIMIT,
+                    MAX_ENROLLMENT_RECOVERY_LIMIT,
+                    'Enrollment recovery limit',
+                ),
+            });
+            const now = readClock(clock);
+            return rows.map(row => toRecovery(row, now));
+        },
+
+        async readGrantStatus(input) {
+            return await readRestrictedDeviceGrantStatus({
+                authorityIncarnation,
+                accountId: input.accountId,
+                grantId: input.grantId,
+                nowMs: readClock(clock).getTime(),
+                lookupGrant: async id => await store.findGrant(id),
+            });
+        },
+
+        async revokeGrant(input) {
+            return await revokeRestrictedDeviceGrant({
+                authorityIncarnation,
+                accountId: input.accountId,
+                grantId: input.grantId,
+                nowMs: readClock(clock).getTime(),
+                revokeConditionally: async claim => await store.revokeGrantConditionally(claim),
+            });
+        },
+
+        async buildGrantClaims(input) {
+            const grant = await store.findGrant(input.grantId);
+            return buildRestrictedDeviceGrantClaims({
+                authorityIncarnation,
+                accountId: input.accountId,
+                grant,
+                nowMs: readClock(clock).getTime(),
+                tokenTtlMs: input.tokenTtlMs,
+            });
+        },
+
+        async cleanupExpiredEnrollments(input) {
+            return await store.deleteExpiredUnusedEnrollments({
+                authorityIncarnation,
+                now: readClock(clock),
+                limit: readLimit(
+                    input?.limit,
+                    DEFAULT_ENROLLMENT_CLEANUP_LIMIT,
+                    MAX_ENROLLMENT_CLEANUP_LIMIT,
+                    'Enrollment cleanup limit',
+                ),
+            });
+        },
+    };
+}
