+    });
+
+    it('bounds enrollment lifetime and generated secret shape', () => {
+        const ctx = setup();
+        expect(errorCode(() => createPendingEnrollment({
+            accountId,
+            authorityIncarnation,
+            nowMs: startMs,
+            ttlMs: MIN_DEVICE_ENROLLMENT_TTL_MS - 1,
+        }))).toBe('invalid-request');
+        expect(errorCode(() => createPendingEnrollment({
+            accountId,
+            authorityIncarnation,
+            nowMs: startMs,
+            ttlMs: MAX_DEVICE_ENROLLMENT_TTL_MS + 1,
+        }))).toBe('invalid-request');
+        expect(errorCode(() => createPendingEnrollment({
+            accountId,
+            authorityIncarnation: 'not-a-uuid',
