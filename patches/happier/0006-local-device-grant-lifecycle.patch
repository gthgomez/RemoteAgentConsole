+        ctx.set(startMs + MIN_DEVICE_ENROLLMENT_TTL_MS);
+        await expect(redeem(ctx, enrollment.secret)).rejects.toMatchObject({ code: 'enrollment-not-usable' });
+        expect(ctx.enrollments[0]!.consumedAt).toBeNull();
