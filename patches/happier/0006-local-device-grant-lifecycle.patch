+
+        const fresh = await ctx.authority.createEnrollment({ accountId, kind: 'phone' });
+        await expect(redeem(ctx, fresh.secret)).resolves.toMatchObject({ grantId: 'grant-2', generation: 1 });
+        expect(ctx.grants.map(grant => grant.revokedAt !== null)).toEqual([true, false]);
+    });
+
+    it('bounds pending enrollment storage and cleans only expired unused rows', async () => {
+        const ctx = setup();
+        for (let index = 0; index < MAX_PENDING_ENROLLMENTS_PER_ACCOUNT; index += 1) {
+            await ctx.authority.createEnrollment({ accountId, kind: 'phone' });
+        }
+        await expect(ctx.authority.createEnrollment({ accountId, kind: 'phone' })).rejects
+            .toMatchObject({ code: 'enrollment-limit' });
+
+        ctx.advance(MAX_DEVICE_ENROLLMENT_TTL_MS + 1);
+        await expect(ctx.authority.cleanupExpiredEnrollments()).resolves
+            .toBe(MAX_PENDING_ENROLLMENTS_PER_ACCOUNT);
+        expect(ctx.enrollments).toHaveLength(0);
+
+        const redeemed = await enrollAndRedeem(ctx);
+        await expect(ctx.authority.revokeGrant({ accountId, grantId: redeemed.grant.grantId })).resolves.toBe(true);
+        ctx.advance(MAX_DEVICE_ENROLLMENT_TTL_MS + 1);
+        await expect(ctx.authority.cleanupExpiredEnrollments()).resolves.toBe(0);
+        expect(ctx.enrollments).toHaveLength(1);
+        expect(ctx.grants).toHaveLength(1);
+        expect(ctx.grants[0]!.revokedAt).not.toBeNull();
+    });
