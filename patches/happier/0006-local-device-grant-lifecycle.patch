+import { db } from '@/storage/db';
+
+import {
+    MAX_RESTRICTED_DEVICE_GENERATION,
+    isRestrictedDeviceKind,
+} from './restrictedDeviceClaimsContract';
+import {
+    createRestrictedDeviceAuthority,
+    type RecoveryEnrollmentRow,
+    type RestrictedDeviceAuthority,
+    type RestrictedDeviceAuthorityStore,
+} from './restrictedDeviceAuthority';
+import {
+    RestrictedDeviceGrantLifecycleError,
+    type RestrictedDeviceGrantRecord,
+} from './restrictedDeviceEnrollment';
+
+type PrismaRecoveryRow = Readonly<{
+    id: string;
+    accountId: string;
+    authorityIncarnation: string;
+    kind: string;
+    createdAt: Date;
+    expiresAt: Date;
+    consumedAt: Date | null;
+    redeemedGrantId: string | null;
+    redeemedGrant: Readonly<{
+        id: string;
+        accountId: string;
+        authorityIncarnation: string;
+        kind: string;
+        generation: number;
+        createdAt: Date;
+        revokedAt: Date | null;
+    }> | null;
+}>;
+
+function toRecoveryRow(row: PrismaRecoveryRow): RecoveryEnrollmentRow {
+    return {
+        id: row.id,
+        accountId: row.accountId,
+        authorityIncarnation: row.authorityIncarnation,
+        kind: row.kind,
+        createdAt: row.createdAt,
+        expiresAt: row.expiresAt,
+        consumedAt: row.consumedAt,
+        redeemedGrantId: row.redeemedGrantId,
+        grant: row.redeemedGrant
+            ? {
+                id: row.redeemedGrant.id,
+                accountId: row.redeemedGrant.accountId,
+                authorityIncarnation: row.redeemedGrant.authorityIncarnation,
+                kind: row.redeemedGrant.kind,
+                generation: row.redeemedGrant.generation,
+                createdAt: row.redeemedGrant.createdAt,
+                revokedAt: row.redeemedGrant.revokedAt,
+            }
+            : null,
+    };
+}
+
+async function findGrant(id: string): Promise<RestrictedDeviceGrantRecord | null> {
+    return await db.restrictedDeviceGrant.findUnique({ where: { id } });
+}
+
+function isTransactionConflict(error: unknown): boolean {
+    return typeof error === 'object' && error !== null && 'code' in error
+        && (error as { code?: unknown }).code === 'P2034';
+}
+
+/** Keep the per-account pending cap strict under concurrent issuance. */
+async function withSerializableRetry<T>(operation: () => Promise<T>): Promise<T> {
+    for (let attempt = 0; ; attempt += 1) {
+        try {
+            return await operation();
+        } catch (error) {
+            if (isTransactionConflict(error) && attempt < 2) continue;
+            throw error;
+        }
+    }
