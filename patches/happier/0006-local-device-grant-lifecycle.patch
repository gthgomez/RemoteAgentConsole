@@ -0,0 +1,104 @@
+/**
+ * Single dependency-free source for restricted device claim shape and bounds.
+ *
+ * The verifier and the issuer both use this module so a produced claim cannot
+ * drift from the accepted claim schema. Keep it free of runtime imports so the
+ * contract can be exercised without the server dependency tree.
+ */
+
+export const RESTRICTED_DEVICE_CLAIM_FORMAT = 'restricted-device-v1' as const;
+export const RESTRICTED_DEVICE_KINDS = ['phone', 'host'] as const;
+export type RestrictedDeviceKind = (typeof RESTRICTED_DEVICE_KINDS)[number];
+
+export const MAX_RESTRICTED_DEVICE_GENERATION = 2_147_483_647;
+export const MAX_RESTRICTED_DEVICE_IDENTIFIER_LENGTH = 256;
+export const MAX_DEVICE_CLAIM_LIFETIME_MS = 7 * 24 * 60 * 60_000;
+
+// RFC 9562 variants and versions: keeps the verifier's UUID strictness.
+export const AUTHORITY_INCARNATION_PATTERN =
+    /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
+
+const CLAIM_KEYS = [
+    'format',
+    'authorityIncarnation',
+    'accountId',
+    'grantId',
+    'grantGeneration',
+    'kind',
+    'issuedAtMs',
+    'expiresAtMs',
+] as const;
+
+export type RestrictedDeviceGrantClaims = Readonly<{
+    format: typeof RESTRICTED_DEVICE_CLAIM_FORMAT;
+    authorityIncarnation: string;
+    accountId: string;
+    grantId: string;
+    grantGeneration: number;
+    kind: RestrictedDeviceKind;
+    issuedAtMs: number;
+    expiresAtMs: number;
+}>;
+
+export type RestrictedDeviceClaimTimes = Readonly<{
+    issuedAtMs: number;
+    expiresAtMs: number;
+}>;
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+    return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+export function isBoundedRestrictedDeviceIdentifier(value: unknown): value is string {
+    return typeof value === 'string'
+        && value.length > 0
+        && value.length <= MAX_RESTRICTED_DEVICE_IDENTIFIER_LENGTH
+        && !value.includes('\0');
+}
+
+export function isRestrictedAuthorityIncarnation(value: unknown): value is string {
+    return typeof value === 'string' && AUTHORITY_INCARNATION_PATTERN.test(value);
+}
+
+export function isRestrictedDeviceKind(value: unknown): value is RestrictedDeviceKind {
+    return value === 'phone' || value === 'host';
+}
+
+/** Strict parser: exactly the known keys, no extensions, bounded values. */
+export function parseRestrictedDeviceGrantClaims(value: unknown): RestrictedDeviceGrantClaims | null {
+    if (!isRecord(value)) return null;
+    const keys = Object.keys(value);
+    if (keys.length !== CLAIM_KEYS.length || !CLAIM_KEYS.every(key => Object.hasOwn(value, key))) return null;
+    if (value.format !== RESTRICTED_DEVICE_CLAIM_FORMAT) return null;
+    if (!isRestrictedAuthorityIncarnation(value.authorityIncarnation)) return null;
+    if (!isBoundedRestrictedDeviceIdentifier(value.accountId)) return null;
+    if (!isBoundedRestrictedDeviceIdentifier(value.grantId)) return null;
+    if (typeof value.grantGeneration !== 'number'
+        || !Number.isSafeInteger(value.grantGeneration)
+        || value.grantGeneration < 1
+        || value.grantGeneration > MAX_RESTRICTED_DEVICE_GENERATION) return null;
+    if (!isRestrictedDeviceKind(value.kind)) return null;
+    if (typeof value.issuedAtMs !== 'number' || !Number.isSafeInteger(value.issuedAtMs) || value.issuedAtMs < 0) return null;
+    if (typeof value.expiresAtMs !== 'number' || !Number.isSafeInteger(value.expiresAtMs) || value.expiresAtMs <= 0) return null;
+
+    return {
+        format: RESTRICTED_DEVICE_CLAIM_FORMAT,
+        authorityIncarnation: value.authorityIncarnation,
+        accountId: value.accountId,
+        grantId: value.grantId,
+        grantGeneration: value.grantGeneration,
+        kind: value.kind,
+        issuedAtMs: value.issuedAtMs,
+        expiresAtMs: value.expiresAtMs,
+    };
+}
+
+/** Date bound shared by issuance and verification. */
+export function areRestrictedDeviceClaimTimesUsable(claims: RestrictedDeviceClaimTimes, nowMs: number): boolean {
+    if (!Number.isSafeInteger(nowMs) || nowMs < 0) return false;
+    const { issuedAtMs, expiresAtMs } = claims;
+    if (!Number.isSafeInteger(issuedAtMs) || !Number.isSafeInteger(expiresAtMs)) return false;
+    if (issuedAtMs < 0 || expiresAtMs <= 0) return false;
+    if (issuedAtMs > nowMs || expiresAtMs <= nowMs || expiresAtMs <= issuedAtMs) return false;
+    return expiresAtMs - issuedAtMs <= MAX_DEVICE_CLAIM_LIFETIME_MS;
+}
diff --git a/apps/server/sources/app/auth/restrictedDeviceEnrollment.test.ts b/apps/server/sources/app/auth/restrictedDeviceEnrollment.test.ts
