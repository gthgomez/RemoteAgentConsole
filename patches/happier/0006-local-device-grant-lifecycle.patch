+    if (grant.authorityIncarnation !== authorityIncarnation) return 'restore-required';
+    if (grant.revokedAt !== null) return 'revoked';
+    if (grant.id !== grantId) return 'not-found';
+    if (!(grant.createdAt instanceof Date) || !Number.isFinite(grant.createdAt.getTime()) || grant.createdAt.getTime() > nowMs) {
