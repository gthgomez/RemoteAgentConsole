+import { createHash, randomBytes } from 'node:crypto';
+
+import {
+    MAX_DEVICE_CLAIM_LIFETIME_MS,
+    MAX_RESTRICTED_DEVICE_GENERATION,
+    areRestrictedDeviceClaimTimesUsable,
+    isBoundedRestrictedDeviceIdentifier,
+    isRestrictedAuthorityIncarnation,
+    isRestrictedDeviceKind,
+    parseRestrictedDeviceGrantClaims,
+    type RestrictedDeviceGrantClaims,
+    type RestrictedDeviceKind,
+} from './restrictedDeviceClaimsContract';
+
+export type { RestrictedDeviceGrantClaims, RestrictedDeviceKind } from './restrictedDeviceClaimsContract';
+
+/**
+ * Owner-local device enrollment and grant lifecycle primitives.
+ *
+ * These functions hold no ambient authority: the caller supplies the authority
+ * incarnation read from the protected local issuer configuration, and every
+ * storage effect goes through an injected callback. Production call sites must
+ * use the bound closure in `restrictedDeviceAuthority.ts`; these primitives take
+ * an explicit incarnation only for that closure and offline fixtures. The relay
+ * never reaches them, so loopback, public origin, or phone tokens are not
+ * admission factors.
+ */
+
+const ENROLLMENT_SECRET_PATTERN = /^[A-Za-z0-9_-]{43}$/;
+
+export const DEFAULT_DEVICE_ENROLLMENT_TTL_MS = 5 * 60_000;
+export const MIN_DEVICE_ENROLLMENT_TTL_MS = 60_000;
+export const MAX_DEVICE_ENROLLMENT_TTL_MS = 15 * 60_000;
+export const DEFAULT_DEVICE_GRANT_TOKEN_TTL_MS = 12 * 60 * 60_000;
+export const MIN_DEVICE_GRANT_TOKEN_TTL_MS = 60_000;
+export const MAX_DEVICE_GRANT_TOKEN_TTL_MS = MAX_DEVICE_CLAIM_LIFETIME_MS;
+
+export type RestrictedDeviceEnrollmentRecord = Readonly<{
+    accountId: string;
+    authorityIncarnation: string;
+    kind: RestrictedDeviceKind;
+    secretHash: string;
+    createdAt: Date;
+    expiresAt: Date;
+}>;
+
+export type RestrictedDeviceGrantRecord = Readonly<{
+    id: string;
+    accountId: string;
+    authorityIncarnation: string;
+    kind: string;
+    generation: number;
+    createdAt: Date;
+    revokedAt: Date | null;
+}>;
+
+export type RestrictedDeviceGrantStatus = 'active' | 'revoked' | 'restore-required' | 'not-found';
+
+export type RestrictedDeviceGrantLifecycleErrorCode =
+    | 'authority-not-configured'
+    | 'invalid-request'
+    | 'enrollment-not-usable'
+    | 'enrollment-limit'
+    | 'grant-not-found'
+    | 'grant-revoked'
+    | 'restore-required';
+
+export class RestrictedDeviceGrantLifecycleError extends Error {
+    readonly code: RestrictedDeviceGrantLifecycleErrorCode;
+
+    constructor(code: RestrictedDeviceGrantLifecycleErrorCode, message: string) {
+        super(message);
+        this.name = 'RestrictedDeviceGrantLifecycleError';
+        this.code = code;
+    }
+}
+
+function reject(code: RestrictedDeviceGrantLifecycleErrorCode, message: string): never {
+    throw new RestrictedDeviceGrantLifecycleError(code, message);
+}
+
+function readIdentifier(value: unknown, label: string): string {
+    if (!isBoundedRestrictedDeviceIdentifier(value)) {
+        return reject('invalid-request', `${label} must be a bounded non-empty identifier`);
+    }
+    return value;
+}
+
+export function requireRestrictedDeviceAuthorityIncarnation(value: unknown): string {
+    if (!isRestrictedAuthorityIncarnation(value)) {
+        return reject('authority-not-configured', 'Restricted device authority incarnation is missing or invalid');
+    }
+    return value;
+}
+
+function readNowMs(value: unknown): number {
+    if (typeof value !== 'number' || !Number.isSafeInteger(value) || value < 0) {
+        return reject('invalid-request', 'A current timestamp is required');
+    }
+    return value;
+}
+
+function readKind(value: unknown): RestrictedDeviceKind {
+    if (!isRestrictedDeviceKind(value)) {
+        return reject('invalid-request', 'Restricted device kind must be phone or host');
+    }
+    return value;
+}
+
+function readTtlMs(value: unknown, fallback: number, minimum: number, maximum: number, label: string): number {
+    const ttlMs = value === undefined ? fallback : value;
+    if (typeof ttlMs !== 'number' || !Number.isSafeInteger(ttlMs) || ttlMs < minimum || ttlMs > maximum) {
+        return reject('invalid-request', `${label} must be between ${minimum} and ${maximum} milliseconds`);
+    }
+    return ttlMs;
+}
+
+function readGeneration(value: unknown): number {
+    if (typeof value !== 'number' || !Number.isSafeInteger(value)
+        || value < 1 || value > MAX_RESTRICTED_DEVICE_GENERATION) {
+        return reject('restore-required', 'Durable device grant generation is not usable');
+    }
+    return value;
+}
+
+function readGrantKind(value: unknown): RestrictedDeviceKind {
+    if (!isRestrictedDeviceKind(value)) {
+        return reject('restore-required', 'Durable device grant kind is not usable');
+    }
+    return value;
+}
+
+/** One-time secret material is only ever persisted as this domain-separated digest. */
+export function hashDeviceEnrollmentSecret(secret: string): string {
+    if (typeof secret !== 'string' || !ENROLLMENT_SECRET_PATTERN.test(secret)) {
+        return reject('invalid-request', 'Device enrollment secret must be 256 bits of base64url material');
+    }
+    return createHash('sha256').update('rac-device-enrollment-v1:').update(secret).digest('hex');
+}
+
+/**
+ * Build the durable record for a pending enrollment. The returned secret is the
+ * only copy; callers must hand it to the owner-local client exactly once.
+ */
+export function createPendingEnrollment(params: Readonly<{
+    accountId: string;
+    authorityIncarnation: string;
+    kind?: RestrictedDeviceKind;
+    nowMs: number;
+    ttlMs?: number;
+    generateSecret?: () => string;
+}>): Readonly<{ secret: string; record: RestrictedDeviceEnrollmentRecord }> {
+    const accountId = readIdentifier(params.accountId, 'Account id');
+    const authorityIncarnation = requireRestrictedDeviceAuthorityIncarnation(params.authorityIncarnation);
+    const kind = params.kind === undefined ? 'phone' : readKind(params.kind);
+    const nowMs = readNowMs(params.nowMs);
+    const ttlMs = readTtlMs(
+        params.ttlMs,
+        DEFAULT_DEVICE_ENROLLMENT_TTL_MS,
+        MIN_DEVICE_ENROLLMENT_TTL_MS,
+        MAX_DEVICE_ENROLLMENT_TTL_MS,
+        'Device enrollment lifetime',
+    );
+    const secret = params.generateSecret ? params.generateSecret() : randomBytes(32).toString('base64url');
+    const secretHash = hashDeviceEnrollmentSecret(secret);
+    const expiresAtMs = nowMs + ttlMs;
+    if (!Number.isSafeInteger(expiresAtMs)) {
+        return reject('invalid-request', 'Device enrollment expiry is out of range');
+    }
+    return {
+        secret,
+        record: {
+            accountId,
+            authorityIncarnation,
+            kind,
+            secretHash,
+            createdAt: new Date(nowMs),
+            expiresAt: new Date(expiresAtMs),
+        },
+    };
+}
+
+/**
+ * Redeem one pending enrollment into exactly one durable grant. The injected
+ * callback owns the atomic conditional claim at transaction admission; a
+ * repeated, expired, foreign, or previous-incarnation secret must all collapse
+ * to the same null result. The expected kind is ingress-authorized and is part
+ * of the durable claim so a phone path can never redeem a host enrollment.
+ */
+export async function redeemPendingEnrollment(params: Readonly<{
+    accountId: string;
+    authorityIncarnation: string;
+    secret: string;
+    expectedKind: RestrictedDeviceKind;
+    redeemAtomically: (input: Readonly<{
+        secretHash: string;
+        accountId: string;
+        authorityIncarnation: string;
+        expectedKind: RestrictedDeviceKind;
+    }>) => Promise<Readonly<{ grantId: string; generation: number; kind: string }> | null>;
+}>): Promise<Readonly<{ grantId: string; generation: number; kind: RestrictedDeviceKind }>> {
+    const accountId = readIdentifier(params.accountId, 'Account id');
+    const authorityIncarnation = requireRestrictedDeviceAuthorityIncarnation(params.authorityIncarnation);
+    const expectedKind = readKind(params.expectedKind);
+    const secretHash = hashDeviceEnrollmentSecret(params.secret);
+    const redeemed = await params.redeemAtomically({
+        secretHash,
+        accountId,
+        authorityIncarnation,
+        expectedKind,
+    });
+    if (!redeemed) {
+        return reject('enrollment-not-usable', 'Device enrollment is not usable');
+    }
+    const grantId = readIdentifier(redeemed.grantId, 'Device grant id');
+    const generation = readGeneration(redeemed.generation);
+    const kind = readKind(redeemed.kind);
+    if (kind !== expectedKind) {
+        return reject('enrollment-not-usable', 'Device enrollment kind does not match the authorized ingress');
+    }
+    return { grantId, generation, kind };
+}
+
+/**
+ * Signable claims always name the current durable grant and generation. A grant
+ * from another incarnation requires owner re-enrollment; it is never silently
+ * reactivated or downgraded to legacy token issuance.
+ */
+export function buildRestrictedDeviceGrantClaims(params: Readonly<{
+    authorityIncarnation: string;
+    accountId: string;
+    grant: RestrictedDeviceGrantRecord | null;
+    nowMs: number;
+    tokenTtlMs?: number;
+}>): RestrictedDeviceGrantClaims {
+    const authorityIncarnation = requireRestrictedDeviceAuthorityIncarnation(params.authorityIncarnation);
+    const accountId = readIdentifier(params.accountId, 'Account id');
+    const nowMs = readNowMs(params.nowMs);
+    const tokenTtlMs = readTtlMs(
+        params.tokenTtlMs,
+        DEFAULT_DEVICE_GRANT_TOKEN_TTL_MS,
+        MIN_DEVICE_GRANT_TOKEN_TTL_MS,
+        MAX_DEVICE_GRANT_TOKEN_TTL_MS,
+        'Device grant token lifetime',
+    );
+    const grant = params.grant;
+    if (!grant || grant.accountId !== accountId) {
+        return reject('grant-not-found', 'Device grant does not belong to this account');
+    }
+    if (grant.authorityIncarnation !== authorityIncarnation) {
+        return reject('restore-required', 'Device grant belongs to a previous authority incarnation');
+    }
+    if (grant.revokedAt !== null) {
+        return reject('grant-revoked', 'Device grant has been revoked');
+    }
+    const grantId = readIdentifier(grant.id, 'Device grant id');
+    const grantGeneration = readGeneration(grant.generation);
+    const kind = readGrantKind(grant.kind);
+    if (!(grant.createdAt instanceof Date) || !Number.isFinite(grant.createdAt.getTime()) || grant.createdAt.getTime() > nowMs) {
+        return reject('restore-required', 'Durable device grant creation time is not usable');
+    }
+    const expiresAtMs = nowMs + tokenTtlMs;
+    if (!Number.isSafeInteger(expiresAtMs) || expiresAtMs <= nowMs) {
+        return reject('invalid-request', 'Device grant token expiry is out of range');
+    }
+
+    const claims: RestrictedDeviceGrantClaims = {
+        format: 'restricted-device-v1',
+        authorityIncarnation,
+        accountId,
+        grantId,
+        grantGeneration,
+        kind,
+        issuedAtMs: nowMs,
+        expiresAtMs,
+    };
+    // The issuer must produce exactly what the verifier accepts.
