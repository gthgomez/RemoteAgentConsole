+                const grant = await tx.restrictedDeviceGrant.create({
+                    data: {
+                        accountId: enrollment.accountId,
+                        authorityIncarnation: enrollment.authorityIncarnation,
+                        kind: expectedKind,
+                    },
+                });
+                await tx.restrictedDeviceEnrollment.update({
+                    where: { id: enrollment.id },
+                    data: { redeemedGrantId: grant.id },
+                });
+                return { grantId: grant.id, generation: grant.generation, kind: expectedKind };
+            });
+        },
+
+        findGrant,
+
+        async findEnrollment({ id, accountId, authorityIncarnation }) {
+            const row = await db.restrictedDeviceEnrollment.findUnique({
+                where: { id },
+                include: { redeemedGrant: true },
+            });
+            if (!row || row.accountId !== accountId || row.authorityIncarnation !== authorityIncarnation) return null;
+            return toRecoveryRow(row);
+        },
+
+        async listEnrollments({ accountId, authorityIncarnation, limit }) {
+            const rows = await db.restrictedDeviceEnrollment.findMany({
+                where: { accountId, authorityIncarnation },
+                orderBy: { createdAt: 'desc' },
+                take: limit,
+                include: { redeemedGrant: true },
+            });
+            return rows.map(toRecoveryRow);
+        },
+
+        async revokeGrantConditionally({ accountId, authorityIncarnation, grantId, now }) {
+            return await db.$transaction(async (tx) => {
+                const incremented = await tx.restrictedDeviceGrant.updateMany({
+                    where: {
+                        id: grantId,
+                        accountId,
+                        authorityIncarnation,
+                        revokedAt: null,
+                        generation: { lt: MAX_RESTRICTED_DEVICE_GENERATION },
+                    },
+                    data: { revokedAt: now, generation: { increment: 1 } },
+                });
+                if (incremented.count === 1) return 1;
+
+                // A terminal-generation row is revoked without incrementing past
+                // the integer bound; revokedAt alone still invalidates its tokens.
+                const terminal = await tx.restrictedDeviceGrant.updateMany({
+                    where: {
+                        id: grantId,
+                        accountId,
+                        authorityIncarnation,
+                        revokedAt: null,
+                        generation: { gte: MAX_RESTRICTED_DEVICE_GENERATION },
+                    },
+                    data: { revokedAt: now },
+                });
+                return terminal.count;
+            });
+        },
+
+        async deleteExpiredUnusedEnrollments({ authorityIncarnation, now, limit }) {
+            return await db.$transaction(async (tx) => {
+                const expired = await tx.restrictedDeviceEnrollment.findMany({
+                    where: {
+                        authorityIncarnation,
+                        consumedAt: null,
+                        expiresAt: { lte: now },
+                    },
+                    orderBy: { expiresAt: 'asc' },
+                    take: limit,
+                    select: { id: true },
+                });
+                if (expired.length === 0) return 0;
+                const deleted = await tx.restrictedDeviceEnrollment.deleteMany({
+                    where: {
+                        id: { in: expired.map(row => row.id) },
+                        authorityIncarnation,
+                        consumedAt: null,
+                        expiresAt: { lte: now },
+                    },
+                });
+                return deleted.count;
+            });
+        },
+    };
+}
+
+/** Composition used by protected server init; never by relay request handlers. */
+export function createPrismaRestrictedDeviceAuthority(options: Readonly<{
+    authorityIncarnation: string;
+}>): RestrictedDeviceAuthority {
+    return createRestrictedDeviceAuthority({
+        authorityIncarnation: options.authorityIncarnation,
+        store: createPrismaStore(),
+    });
+}
