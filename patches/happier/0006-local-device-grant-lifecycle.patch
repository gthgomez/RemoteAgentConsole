+    });
+
+    it('checks expiry at store admission rather than a caller-supplied time', async () => {
+        const ctx = setup();
+        const enrollment = await ctx.authority.createEnrollment({
+            accountId,
+            kind: 'phone',
+            ttlMs: MIN_DEVICE_ENROLLMENT_TTL_MS,
