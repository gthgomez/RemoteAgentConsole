--- /dev/null
+++ b/apps/server/sources/app/auth/restrictedDeviceEnrollment.test.ts
@@ -0,0 +1,436 @@
+import { describe, expect, it } from 'vitest';
+
+import {
+    MAX_PENDING_ENROLLMENTS_PER_ACCOUNT,
+    createRestrictedDeviceAuthority,
+    type RecoveryEnrollmentRow,
+    type RestrictedDeviceAuthorityStore,
+} from './restrictedDeviceAuthority';
+import {
+    MAX_DEVICE_CLAIM_LIFETIME_MS,
+    MAX_RESTRICTED_DEVICE_GENERATION,
+    areRestrictedDeviceClaimTimesUsable,
+    parseRestrictedDeviceGrantClaims,
+} from './restrictedDeviceClaimsContract';
+import {
+    DEFAULT_DEVICE_ENROLLMENT_TTL_MS,
+    MAX_DEVICE_ENROLLMENT_TTL_MS,
+    MIN_DEVICE_ENROLLMENT_TTL_MS,
+    RestrictedDeviceGrantLifecycleError,
+    buildRestrictedDeviceGrantClaims,
+    createPendingEnrollment,
+    hashDeviceEnrollmentSecret,
+    type RestrictedDeviceKind,
+} from './restrictedDeviceEnrollment';
+
+const authorityIncarnation = 'ca3f8c09-6cca-4042-a47a-978a8c2950ac';
+const replacementIncarnation = '3a8f4d42-2b8e-4fff-8bd2-2fc44d6655c9';
+const accountId = 'fixture-account';
+const startMs = 1_000_000;
+
+type MutableEnrollment = {
+    id: string;
+    accountId: string;
+    authorityIncarnation: string;
+    kind: RestrictedDeviceKind;
+    secretHash: string;
+    createdAt: Date;
+    expiresAt: Date;
+    consumedAt: Date | null;
+    redeemedGrantId: string | null;
+};
+
+type MutableGrant = {
+    id: string;
+    accountId: string;
+    authorityIncarnation: string;
+    kind: RestrictedDeviceKind;
+    generation: number;
+    createdAt: Date;
+    revokedAt: Date | null;
+};
+
+function createClock(start: number) {
+    let current = start;
+    return {
+        clock: () => new Date(current),
+        set: (value: number) => { current = value; },
+        advance: (delta: number) => { current += delta; },
+    };
+}
+
+function createFixtureStore() {
+    const enrollments: MutableEnrollment[] = [];
+    const grants: MutableGrant[] = [];
+    let sequence = 0;
+
+    function toRow(enrollment: MutableEnrollment): RecoveryEnrollmentRow {
+        const grant = enrollment.redeemedGrantId
+            ? grants.find(candidate => candidate.id === enrollment.redeemedGrantId) ?? null
+            : null;
+        return {
+            id: enrollment.id,
+            accountId: enrollment.accountId,
+            authorityIncarnation: enrollment.authorityIncarnation,
+            kind: enrollment.kind,
+            createdAt: enrollment.createdAt,
+            expiresAt: enrollment.expiresAt,
+            consumedAt: enrollment.consumedAt,
+            redeemedGrantId: enrollment.redeemedGrantId,
+            grant,
+        };
+    }
+
+    const store: RestrictedDeviceAuthorityStore = {
+        async createEnrollment({ record, maxPending, clock }) {
+            const admittedAt = clock();
+            for (let index = enrollments.length - 1; index >= 0; index -= 1) {
+                const candidate = enrollments[index]!;
+                if (candidate.accountId === record.accountId
+                    && candidate.authorityIncarnation === record.authorityIncarnation
+                    && candidate.consumedAt === null
+                    && candidate.expiresAt.getTime() <= admittedAt.getTime()) {
+                    enrollments.splice(index, 1);
+                }
+            }
+            const pending = enrollments.filter(candidate => (
+                candidate.accountId === record.accountId
+                && candidate.authorityIncarnation === record.authorityIncarnation
+                && candidate.consumedAt === null
+                && candidate.expiresAt.getTime() > admittedAt.getTime()
+            )).length;
+            if (pending >= maxPending) {
+                throw new RestrictedDeviceGrantLifecycleError(
+                    'enrollment-limit',
+                    'fixture enrollment limit',
+                );
+            }
+            const id = `enrollment-${++sequence}`;
+            enrollments.push({ ...record, id, consumedAt: null, redeemedGrantId: null });
+            return { id, expiresAt: record.expiresAt };
+        },
+        async redeemEnrollment({ secretHash, accountId: requestedAccount, authorityIncarnation: requestedIncarnation, expectedKind, clock }) {
+            const admittedAt = clock();
+            const enrollment = enrollments.find(candidate => candidate.secretHash === secretHash);
+            if (!enrollment
+                || enrollment.accountId !== requestedAccount
+                || enrollment.authorityIncarnation !== requestedIncarnation
+                || enrollment.kind !== expectedKind
+                || enrollment.consumedAt !== null
+                || enrollment.expiresAt.getTime() <= admittedAt.getTime()) return null;
+            enrollment.consumedAt = admittedAt;
+            const grant: MutableGrant = {
+                id: `grant-${grants.length + 1}`,
+                accountId: enrollment.accountId,
+                authorityIncarnation: enrollment.authorityIncarnation,
+                kind: expectedKind,
+                generation: 1,
+                createdAt: admittedAt,
+                revokedAt: null,
+            };
+            grants.push(grant);
+            enrollment.redeemedGrantId = grant.id;
+            return { grantId: grant.id, generation: grant.generation, kind: expectedKind };
+        },
+        async findGrant(id) {
+            return grants.find(grant => grant.id === id) ?? null;
+        },
+        async findEnrollment({ id, accountId: requestedAccount, authorityIncarnation: requestedIncarnation }) {
+            const enrollment = enrollments.find(candidate => candidate.id === id);
+            if (!enrollment
+                || enrollment.accountId !== requestedAccount
+                || enrollment.authorityIncarnation !== requestedIncarnation) return null;
+            return toRow(enrollment);
+        },
+        async listEnrollments({ accountId: requestedAccount, authorityIncarnation: requestedIncarnation, limit }) {
+            return enrollments
+                .filter(candidate => candidate.accountId === requestedAccount
+                    && candidate.authorityIncarnation === requestedIncarnation)
+                .sort((left, right) => right.createdAt.getTime() - left.createdAt.getTime())
+                .slice(0, limit)
+                .map(toRow);
+        },
+        async revokeGrantConditionally({ accountId: requestedAccount, authorityIncarnation: requestedIncarnation, grantId, now }) {
+            const grant = grants.find(candidate => candidate.id === grantId);
+            if (!grant
+                || grant.accountId !== requestedAccount
+                || grant.authorityIncarnation !== requestedIncarnation
+                || grant.revokedAt !== null) return 0;
+            grant.revokedAt = now;
+            if (grant.generation < MAX_RESTRICTED_DEVICE_GENERATION) grant.generation += 1;
+            return 1;
+        },
+        async deleteExpiredUnusedEnrollments({ authorityIncarnation: requestedIncarnation, now, limit }) {
+            let deleted = 0;
+            for (let index = 0; index < enrollments.length && deleted < limit; index += 1) {
+                const candidate = enrollments[index]!;
+                if (candidate.authorityIncarnation === requestedIncarnation
+                    && candidate.consumedAt === null
+                    && candidate.expiresAt.getTime() <= now.getTime()) {
+                    enrollments.splice(index, 1);
+                    index -= 1;
+                    deleted += 1;
+                }
+            }
+            return deleted;
+        },
+    };
+
+    return { store, enrollments, grants };
+}
+
+function setup(incarnation = authorityIncarnation) {
+    const fixture = createFixtureStore();
+    const time = createClock(startMs);
+    const authority = createRestrictedDeviceAuthority({
+        authorityIncarnation: incarnation,
+        store: fixture.store,
+        clock: time.clock,
+    });
+    return { ...fixture, ...time, authority };
+}
+
+function errorCode(run: () => unknown): string | undefined {
+    try {
+        run();
+    } catch (error) {
+        return (error as { code?: string }).code;
+    }
+    return undefined;
+}
+
+async function rejectionCode(promise: Promise<unknown>): Promise<string | undefined> {
+    try {
+        await promise;
+    } catch (error) {
+        return (error as { code?: string }).code;
+    }
+    return undefined;
+}
+
+async function redeem(ctx: ReturnType<typeof setup>, secret: string, kind: RestrictedDeviceKind = 'phone') {
+    return await ctx.authority.redeemEnrollment({ accountId, secret, expectedKind: kind });
+}
+
+async function enrollAndRedeem(ctx: ReturnType<typeof setup>, kind: RestrictedDeviceKind = 'phone') {
+    const enrollment = await ctx.authority.createEnrollment({ accountId, kind });
+    const grant = await redeem(ctx, enrollment.secret, kind);
+    return { enrollment, grant };
+}
+
+describe('restricted device authority lifecycle', () => {
+    it('persists only a one-time secret hash and redeems it into one grant', async () => {
