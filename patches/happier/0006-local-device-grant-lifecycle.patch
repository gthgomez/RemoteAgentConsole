+        await expect(ctx.authority.buildGrantClaims({ accountId, grantId: grant.grantId })).rejects
+            .toMatchObject({ code: 'grant-revoked' });
+
+        const foreign = setup();
+        const foreignGrant = await enrollAndRedeem(foreign);
