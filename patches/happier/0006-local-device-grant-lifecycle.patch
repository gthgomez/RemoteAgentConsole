+
+function createPrismaStore(): RestrictedDeviceAuthorityStore {
+    return {
+        async createEnrollment({ record, maxPending, clock }) {
+            return await withSerializableRetry(async () => await db.$transaction(async (tx) => {
+                const admittedAt = clock();
+                await tx.restrictedDeviceEnrollment.deleteMany({
+                    where: {
+                        accountId: record.accountId,
+                        authorityIncarnation: record.authorityIncarnation,
+                        consumedAt: null,
+                        expiresAt: { lte: admittedAt },
+                    },
+                });
+                const pending = await tx.restrictedDeviceEnrollment.count({
+                    where: {
+                        accountId: record.accountId,
+                        authorityIncarnation: record.authorityIncarnation,
+                        consumedAt: null,
+                        expiresAt: { gt: admittedAt },
+                    },
+                });
