+        await expect(previousIncarnation.readGrantStatus({ accountId, grantId: grant.grantId }))
+            .resolves.toBe('restore-required');
+        await expect(previousIncarnation.buildGrantClaims({ accountId, grantId: grant.grantId }))
+            .rejects.toMatchObject({ code: 'restore-required' });
