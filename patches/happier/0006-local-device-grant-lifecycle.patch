new file mode 100644
index 0000000..d318a57
--- /dev/null
+++ b/apps/server/sources/app/auth/restrictedDeviceAuthority.integration.spec.ts
@@ -0,0 +1,311 @@
+/**
+ * Selected SQLite integration spec for the restricted device authority.
+ *
+ * This is the installed-runtime companion to the offline qualification fixtures.
+ * It is executable only in a complete Happier checkout with the pinned
+ * dependency install, the generated SQLite Prisma client, and the upstream
+ * migration deploy path. The offline patch workspace reports it as NOT_RUN.
+ *
+ * Preconditions: the disposable authorized Linux checkout already has portable
+ * Node 24.22.1 and Yarn 1.22.22 visible on PATH. Do not activate or install
+ * package-manager shims or globals; use only the provisioned tools. From the
+ * checkout root, confirm the versions and run the supported commands:
+ *   node --version                 # expect v24.22.1
+ *   yarn --version                 # expect 1.22.22
+ *   yarn install --frozen-lockfile
+ *   yarn --cwd apps/server build:shared
+ *   yarn --cwd apps/server generate:light
+ *   yarn --cwd apps/server test:integration \
+ *     sources/app/auth/restrictedDeviceAuthority.integration.spec.ts
+ *
+ * `generate:light` runs `schema:sync` and `prisma generate` for the SQLite
+ * schema. `build:shared` is explicit because the server `test:integration`
+ * script has no `pretest` hook (only `test:unit` does). Do not use Yarn Berry's
+ * `--immutable` flag with this Yarn Classic repository.
+ *
+ * createLightSqliteHarness runs migrate:sqlite:deploy against a temporary
+ * SQLite file, then initializes the real auth module from the supplied restricted
+ * environment. No HTTP route, relay listener, or production profile is started.
+ */
+
+import { randomUUID } from 'node:crypto';
+
+import { createPersistentTokenGenerator } from 'privacy-kit';
+import { afterAll, afterEach, beforeAll, describe, expect, it } from 'vitest';
+
+import { auth } from '@/app/auth/auth';
+import { db } from '@/storage/db';
+import { createLightSqliteHarness, type LightSqliteHarness } from '@/testkit/lightSqliteHarness';
+
+import { MAX_RESTRICTED_DEVICE_GENERATION } from './restrictedDeviceClaimsContract';
+import { createPrismaRestrictedDeviceAuthority } from './restrictedDeviceEnrollmentStore';
+import { verifyRestrictedDeviceGrant } from './restrictedDeviceGrants';
+
+const incarnation = 'ca3f8c09-6cca-4042-a47a-978a8c2950ac';
+const replacementIncarnation = '3a8f4d42-2b8e-4fff-8bd2-2fc44d6655c9';
+const fixtureSecret = Buffer.alloc(32, 29).toString('base64url');
+
+let harness: LightSqliteHarness;
+
+beforeAll(async () => {
+    harness = await createLightSqliteHarness({
+        tempDirPrefix: 'happier-restricted-device-authority-',
+        initAuth: true,
+        env: {
+            HANDY_MASTER_SECRET: fixtureSecret,
+            HAPPIER_RAC_RESTRICTED_DEPLOYMENT: '1',
+            HAPPIER_RAC_AUTH_INCARNATION: incarnation,
+        },
+    });
+}, 120_000);
+
+afterEach(async () => {
+    await db.restrictedDeviceEnrollment.deleteMany();
+    await db.restrictedDeviceGrant.deleteMany();
+    await db.account.deleteMany();
+});
+
+afterAll(async () => {
+    await harness?.close();
+});
+
+function authority() {
+    const bound = auth.getRestrictedDeviceAuthority();
+    expect(bound).not.toBeNull();
+    if (!bound) throw new Error('Restricted device authority is not bound');
+    return bound;
+}
+
+async function createAccount() {
+    return await db.account.create({ data: { publicKey: randomUUID() } });
+}
+
+async function enroll(accountId: string, kind: 'phone' | 'host') {
+    return await authority().createEnrollment({ accountId, kind });
+}
+
+async function redeem(accountId: string, secret: string, expectedKind: 'phone' | 'host') {
+    return await authority().redeemEnrollment({ accountId, secret, expectedKind });
+}
+
+async function enrollAndRedeem(accountId: string, kind: 'phone' | 'host') {
+    const pending = await enroll(accountId, kind);
+    const grant = await redeem(accountId, pending.secret, kind);
+    return { pending, grant };
+}
+
+function grantLookup(id: string) {
+    return db.restrictedDeviceGrant.findUnique({ where: { id } });
+}
+
+describe('restricted device authority (SQLite integration)', () => {
+    it('commits one redemption, fails closed on a lost response, and recovers the orphan grant', async () => {
+        const account = await createAccount();
+        const pending = await enroll(account.id, 'phone');
+        const committed = await redeem(account.id, pending.secret, 'phone');
+
+        // Simulate a lost response: retry with only the client-visible secret.
+        await expect(redeem(account.id, pending.secret, 'phone')).rejects
+            .toMatchObject({ code: 'enrollment-not-usable' });
+        const grants = await db.restrictedDeviceGrant.findMany({ where: { accountId: account.id } });
+        expect(grants).toHaveLength(1);
+        expect(grants[0]).toMatchObject({
+            id: committed.grantId,
+            kind: 'phone',
+            generation: 1,
+            revokedAt: null,
+        });
+        const enrollment = await db.restrictedDeviceEnrollment.findUnique({
+            where: { id: pending.enrollmentId },
+        });
+        expect(enrollment).toMatchObject({
+            consumedAt: expect.any(Date),
+            redeemedGrantId: committed.grantId,
+        });
+
+        const recovery = await authority().readEnrollmentRecovery({
+            accountId: account.id,
+            enrollmentId: pending.enrollmentId,
+        });
+        expect(recovery).toMatchObject({
+            state: 'redeemed',
+            grant: { grantId: committed.grantId, revokedAt: null },
+        });
+        expect(JSON.stringify(recovery)).not.toContain(pending.secret);
+
+        await expect(authority().revokeGrant({
+            accountId: account.id,
+            grantId: committed.grantId,
+        })).resolves.toBe(true);
+        const fresh = await enrollAndRedeem(account.id, 'phone');
+        expect(fresh.grant.grantId).not.toBe(committed.grantId);
+        expect(await db.restrictedDeviceGrant.count({ where: { accountId: account.id } })).toBe(2);
+    });
+
+    it('issues a restricted token accepted by the actual verifier and denies signed legacy tokens', async () => {
+        const account = await createAccount();
+        const { grant } = await enrollAndRedeem(account.id, 'phone');
+        const token = await auth.createRestrictedDeviceToken(account.id, grant.grantId);
+
+        await expect(auth.verifyToken(token)).resolves.toMatchObject({
+            userId: account.id,
+            deviceGrant: { grantId: grant.grantId, generation: 1, kind: 'phone' },
+        });
+
+        const legacy = await createPersistentTokenGenerator({ service: 'handy', seed: fixtureSecret });
+        const issuedAtMs = Date.now();
+        const legacyToken = await legacy.new({ user: account.id });
+        const legacyClaimToken = await legacy.new({
+            user: account.id,
+            extras: {
+                format: 'restricted-device-v1',
+                authorityIncarnation: incarnation,
+                accountId: account.id,
+                grantId: grant.grantId,
+                grantGeneration: 1,
+                kind: 'phone',
+                issuedAtMs,
+                expiresAtMs: issuedAtMs + 60_000,
+            },
+        });
+        await expect(auth.verifyToken(legacyToken)).resolves.toBeNull();
+        await expect(auth.verifyToken(legacyClaimToken)).resolves.toBeNull();
+        await expect(auth.createToken(account.id)).rejects.toThrow('local device enrollment');
+    });
+
+    it('selectively revokes phones and a host without crossing expected kinds', async () => {
+        const account = await createAccount();
+        const phoneA = await enrollAndRedeem(account.id, 'phone');
+        const phoneB = await enrollAndRedeem(account.id, 'phone');
+        const host = await enrollAndRedeem(account.id, 'host');
+        const tokens = {
+            phoneA: await auth.createRestrictedDeviceToken(account.id, phoneA.grant.grantId),
+            phoneB: await auth.createRestrictedDeviceToken(account.id, phoneB.grant.grantId),
+            host: await auth.createRestrictedDeviceToken(account.id, host.grant.grantId),
+        };
+        for (const token of Object.values(tokens)) {
+            await expect(auth.verifyToken(token)).resolves.not.toBeNull();
+        }
+
+        const hostPending = await enroll(account.id, 'host');
+        await expect(redeem(account.id, hostPending.secret, 'phone')).rejects
+            .toMatchObject({ code: 'enrollment-not-usable' });
+        expect(await db.restrictedDeviceEnrollment.findUnique({
+            where: { id: hostPending.enrollmentId },
+        })).toMatchObject({ consumedAt: null });
+
+        await expect(authority().revokeGrant({
+            accountId: account.id,
+            grantId: phoneA.grant.grantId,
+        })).resolves.toBe(true);
+        await expect(authority().revokeGrant({
+            accountId: account.id,
+            grantId: host.grant.grantId,
+        })).resolves.toBe(true);
+        await expect(auth.verifyToken(tokens.phoneA)).resolves.toBeNull();
+        await expect(auth.verifyToken(tokens.host)).resolves.toBeNull();
+        await expect(auth.verifyToken(tokens.phoneB)).resolves.toMatchObject({
+            deviceGrant: { grantId: phoneB.grant.grantId, kind: 'phone' },
+        });
+
+        await expect(db.restrictedDeviceGrant.findUnique({ where: { id: phoneA.grant.grantId } }))
+            .resolves.toMatchObject({ generation: 2, revokedAt: expect.any(Date) });
+        await expect(db.restrictedDeviceGrant.findUnique({ where: { id: host.grant.grantId } }))
+            .resolves.toMatchObject({ generation: 2, revokedAt: expect.any(Date) });
+        await expect(db.restrictedDeviceGrant.findUnique({ where: { id: phoneB.grant.grantId } }))
+            .resolves.toMatchObject({ generation: 1, revokedAt: null });
+    });
+
+    it('revokes a terminal-generation row through the actual Prisma path without overflow', async () => {
+        const account = await createAccount();
+        const { grant } = await enrollAndRedeem(account.id, 'phone');
+        const token = await auth.createRestrictedDeviceToken(account.id, grant.grantId);
+        await db.restrictedDeviceGrant.update({
+            where: { id: grant.grantId },
+            data: { generation: MAX_RESTRICTED_DEVICE_GENERATION },
+        });
+
+        await expect(authority().revokeGrant({
+            accountId: account.id,
+            grantId: grant.grantId,
+        })).resolves.toBe(true);
+        await expect(authority().revokeGrant({
+            accountId: account.id,
+            grantId: grant.grantId,
+        })).resolves.toBe(false);
+        await expect(db.restrictedDeviceGrant.findUnique({ where: { id: grant.grantId } }))
+            .resolves.toMatchObject({
+                generation: MAX_RESTRICTED_DEVICE_GENERATION,
+                revokedAt: expect.any(Date),
+            });
+        await expect(auth.verifyToken(token)).resolves.toBeNull();
+    });
+
+    it('gives no restore credit across a synthetic incarnation rotation', async () => {
+        const account = await createAccount();
+        const current = await enrollAndRedeem(account.id, 'phone');
+        const token = await auth.createRestrictedDeviceToken(account.id, current.grant.grantId);
+        await expect(auth.verifyToken(token)).resolves.toMatchObject({
+            deviceGrant: { grantId: current.grant.grantId },
+        });
+        const pending = await enroll(account.id, 'phone');
+
+        const rotated = createPrismaRestrictedDeviceAuthority({
+            authorityIncarnation: replacementIncarnation,
+        });
+        await expect(rotated.readGrantStatus({
+            accountId: account.id,
+            grantId: current.grant.grantId,
+        })).resolves.toBe('restore-required');
+        await expect(rotated.buildGrantClaims({
+            accountId: account.id,
+            grantId: current.grant.grantId,
+        })).rejects.toMatchObject({ code: 'restore-required' });
+        await expect(rotated.redeemEnrollment({
+            accountId: account.id,
+            secret: pending.secret,
+            expectedKind: 'phone',
+        })).rejects.toMatchObject({ code: 'enrollment-not-usable' });
+        await expect(rotated.readEnrollmentRecovery({
+            accountId: account.id,
+            enrollmentId: pending.enrollmentId,
+        })).resolves.toBeNull();
+
+        const claims = await authority().buildGrantClaims({
+            accountId: account.id,
+            grantId: current.grant.grantId,
+        });
+        await expect(verifyRestrictedDeviceGrant({
+            authorityIncarnation: replacementIncarnation,
+            userId: account.id,
+            signedExtras: claims,
+            nowMs: Date.now(),
+            lookupGrant: grantLookup,
+        })).resolves.toBeNull();
+
+        await expect(db.restrictedDeviceGrant.findUnique({ where: { id: current.grant.grantId } }))
+            .resolves.toMatchObject({ generation: 1, revokedAt: null });
+        await expect(db.restrictedDeviceEnrollment.findUnique({ where: { id: pending.enrollmentId } }))
+            .resolves.toMatchObject({ consumedAt: null, redeemedGrantId: null });
+        expect(await db.restrictedDeviceGrant.count({ where: { accountId: account.id } })).toBe(1);
+
+        // Rotation requires a fresh pairing; it must not reuse the old grant.
+        const fresh = await rotated.createEnrollment({ accountId: account.id, kind: 'phone' });
+        const freshGrant = await rotated.redeemEnrollment({
+            accountId: account.id,
+            secret: fresh.secret,
+            expectedKind: 'phone',
+        });
+        expect(freshGrant.grantId).not.toBe(current.grant.grantId);
+        expect(await db.restrictedDeviceGrant.count({
+            where: { accountId: account.id, authorityIncarnation: replacementIncarnation },
+        })).toBe(1);
+        await expect(db.restrictedDeviceGrant.findUnique({ where: { id: current.grant.grantId } }))
+            .resolves.toMatchObject({ generation: 1, revokedAt: null });
+        // The active issuer is unchanged; rotation is synthetic and must not
+        // revoke or re-credit the original grant.
+        await expect(auth.verifyToken(token)).resolves.toMatchObject({
+            deviceGrant: { grantId: current.grant.grantId },
+        });
+    });
+});
