+        await expect(ctx.authority.revokeGrant({ accountId, grantId: grant.grantId })).resolves.toBe(true);
+        expect(ctx.grants[0]!.generation).toBe(MAX_RESTRICTED_DEVICE_GENERATION);
+        expect(ctx.grants[0]!.revokedAt).not.toBeNull();
