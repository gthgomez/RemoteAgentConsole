+ * revocation when it can, so an already-cached token for the same grant stops
+ * verifying; terminal-generation rows are revoked without an increment.
+ */
+export async function revokeRestrictedDeviceGrant(params: Readonly<{
+    accountId: string;
+    authorityIncarnation: string;
+    grantId: string;
+    nowMs: number;
+    revokeConditionally: (input: Readonly<{
+        accountId: string;
+        authorityIncarnation: string;
+        grantId: string;
+        now: Date;
+    }>) => Promise<number>;
+}>): Promise<boolean> {
+    const accountId = readIdentifier(params.accountId, 'Account id');
+    const authorityIncarnation = requireRestrictedDeviceAuthorityIncarnation(params.authorityIncarnation);
+    const grantId = readIdentifier(params.grantId, 'Device grant id');
+    const nowMs = readNowMs(params.nowMs);
+    const updated = await params.revokeConditionally({
+        accountId,
+        authorityIncarnation,
+        grantId,
+        now: new Date(nowMs),
+    });
+    if (!Number.isSafeInteger(updated) || updated < 0 || updated > 1) {
+        return reject('invalid-request', 'Conditional device grant revocation must affect at most one row');
+    }
+    return updated === 1;
+}
