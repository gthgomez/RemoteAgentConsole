index 00000000..f4f55661
--- /dev/null
+++ b/apps/cli/src/security/restrictedDeployment/policy.test.ts
@@ -0,0 +1,112 @@
+import { mkdirSync, mkdtempSync, realpathSync, renameSync, rmSync, statSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { afterEach, beforeEach, describe, expect, it } from 'vitest';
+
+import { createRestrictedRpcAdmission } from './authorizeRpc';
+
+describe('restricted deployment RPC admission', () => {
+  let root: string;
+  let project: string;
+  let policyPath: string;
+
+  function directoryIdentity(path: string): string {
+    const stat = statSync(path, { bigint: true });
+    return `${stat.dev}:${stat.ino}`;
+  }
+
+  function policy() {
+    return {
+      schemaVersion: 1,
+      revision: 'fixture-revision',
+      projects: [{ projectId: 'fixture', canonicalPath: project, directoryIdentity: directoryIdentity(project) }],
+      profiles: ['command-code', 'opencode', 'codex', 'babel'].map(id => ({
+        id,
+        backendId: id,
+        commandFingerprint: 'a'.repeat(64),
+        remoteSettings: [] as string[],
+      })),
+      allowedMachineMethods: ['capabilities.invoke', 'bash'],
+      allowedSessionMethods: ['session.workState.get', 'writeFile', 'daemon.terminal.input', 'future.handler'],
+      forbiddenMethods: [] as string[],
+    };
+  }
+
+  function publish(value = policy()): NodeJS.ProcessEnv {
+    writeFileSync(policyPath, JSON.stringify(value), { mode: 0o600 });
+    return { HAPPIER_RAC_RESTRICTED_DEPLOYMENT: '1', HAPPIER_RAC_POLICY_FILE: policyPath };
+  }
+
+  beforeEach(() => {
+    root = realpathSync(mkdtempSync(join(tmpdir(), 'happier-restricted-')));
+    project = join(root, 'project');
+    policyPath = join(root, 'policy.json');
+    mkdirSync(project);
+  });
+
+  afterEach(() => rmSync(root, { recursive: true, force: true }));
+
+  it('preserves stock admission only when restricted configuration is absent', () => {
+    expect(createRestrictedRpcAdmission({ scope: 'machine', env: {} })).toBeUndefined();
+    const missing = createRestrictedRpcAdmission({ scope: 'machine', env: { HAPPIER_RAC_RESTRICTED_DEPLOYMENT: '1' } });
+    expect(missing?.('bash', {})).toBe(false);
+    const invalid = createRestrictedRpcAdmission({ scope: 'machine', env: { HAPPIER_RAC_RESTRICTED_DEPLOYMENT: '0' } });
+    expect(invalid?.('bash', {})).toBe(false);
+  });
+
+  it('denies unevaluated methods in both scopes even when listed in the policy', () => {
+    const env = publish();
+    const machine = createRestrictedRpcAdmission({ scope: 'machine', env });
+    const session = createRestrictedRpcAdmission({ scope: 'session', getSessionDirectory: () => project, env });
+    expect(machine?.('bash', {})).toBe(false);
+    expect(machine?.('capabilities.invoke', {})).toBe(false);
+    expect(session?.('writeFile', {})).toBe(false);
+    expect(session?.('daemon.terminal.input', {})).toBe(false);
+    expect(session?.('future.handler', {})).toBe(false);
+    expect(session?.('session.workState.get', { projectId: 'fixture' })).toBe(false);
+    expect(session?.('session.workState.get', {})).toBe(true);
+  });
+
+  it('rechecks receiver-owned directory identity for previously admitted sessions', () => {
+    const session = createRestrictedRpcAdmission({ scope: 'session', getSessionDirectory: () => project, env: publish() });
+    expect(session?.('session.workState.get', {})).toBe(true);
+    renameSync(project, join(root, 'previous'));
+    mkdirSync(project);
+    expect(session?.('session.workState.get', {})).toBe(false);
+  });
+
+  it('waits for a receiver-owned runtime directory and keeps that project bound', () => {
+    const secondProject = join(root, 'second');
+    mkdirSync(secondProject);
+    const config = policy();
+    config.projects.push({ projectId: 'second', canonicalPath: secondProject, directoryIdentity: directoryIdentity(secondProject) });
+    let directory = '';
+    const session = createRestrictedRpcAdmission({ scope: 'session', getSessionDirectory: () => directory, env: publish(config) });
+    expect(session?.('session.workState.get', {})).toBe(false);
+    directory = project;
+    expect(session?.('session.workState.get', {})).toBe(true);
+    directory = secondProject;
+    expect(session?.('session.workState.get', {})).toBe(false);
+  });
+
+  it('denies admission when the policy path lies inside an enrolled project', () => {
+    policyPath = join(project, 'policy.json');
+    const session = createRestrictedRpcAdmission({ scope: 'session', getSessionDirectory: () => project, env: publish() });
+    expect(session?.('session.workState.get', {})).toBe(false);
+  });
+
+  it('denies admission for duplicate project IDs, duplicate profiles, or Babel mode overrides', () => {
+    const secondProject = join(root, 'second');
+    mkdirSync(secondProject);
+    const duplicateProject = policy();
+    duplicateProject.projects.push({ projectId: 'fixture', canonicalPath: secondProject, directoryIdentity: directoryIdentity(secondProject) });
+    const duplicateProfile = policy();
+    duplicateProfile.profiles[0].id = 'babel';
+    const babelOverride = policy();
+    babelOverride.profiles[3].remoteSettings.push('mode');
+    for (const invalid of [duplicateProject, duplicateProfile, babelOverride]) {
+      const session = createRestrictedRpcAdmission({ scope: 'session', getSessionDirectory: () => project, env: publish(invalid) });
+      expect(session?.('session.workState.get', {})).toBe(false);
+    }
+  });
+});
diff --git a/apps/cli/src/security/restrictedDeployment/policy.ts b/apps/cli/src/security/restrictedDeployment/policy.ts
new file mode 100644
index 00000000..ae793766
--- /dev/null
+++ b/apps/cli/src/security/restrictedDeployment/policy.ts
@@ -0,0 +1,116 @@
+import { closeSync, constants, fstatSync, openSync, readSync, realpathSync, statSync } from 'node:fs';
+import { dirname, isAbsolute, normalize, relative, sep } from 'node:path';
+import { z } from 'zod';
+
+export const RESTRICTED_DEPLOYMENT_MODE_ENV = 'HAPPIER_RAC_RESTRICTED_DEPLOYMENT';
+export const RESTRICTED_DEPLOYMENT_POLICY_ENV = 'HAPPIER_RAC_POLICY_FILE';
+
+export function isRestrictedDeploymentConfigured(env: NodeJS.ProcessEnv = process.env): boolean {
+    return env[RESTRICTED_DEPLOYMENT_MODE_ENV] !== undefined || env[RESTRICTED_DEPLOYMENT_POLICY_ENV] !== undefined;
+}
+
+const MAX_POLICY_BYTES = 256 * 1024;
+const PROFILE_IDS = ['command-code', 'opencode', 'codex', 'babel'] as const;
+const identifier = z.string().regex(/^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$/);
+const methods = z.array(identifier).max(128).refine(values => new Set(values).size === values.length);
+const policySchema = z.strictObject({
+    schemaVersion: z.literal(1),
+    revision: identifier,
+    projects: z.array(z.strictObject({
+        projectId: identifier,
+        canonicalPath: z.string().min(1).max(4096),
+        directoryIdentity: z.string().regex(/^\d+:\d+$/),
+    })).min(1).max(128),
+    profiles: z.array(z.strictObject({
+        id: z.enum(PROFILE_IDS),
+        backendId: identifier,
+        commandFingerprint: z.string().regex(/^[a-f0-9]{64}$/),
+        remoteSettings: z.array(z.enum(['model', 'mode'])).max(2)
+            .refine(values => new Set(values).size === values.length),
+    })).length(PROFILE_IDS.length),
+    allowedMachineMethods: methods,
+    allowedSessionMethods: methods,
+    forbiddenMethods: methods,
+});
+
+export type RestrictedDeploymentPolicy = z.infer<typeof policySchema>;
+
+function canonicalLocalPath(path: string): string {
+    if (!isAbsolute(path) || path.includes('\0') || dirname(path) === path) {
+        throw new Error('Expected an absolute local path below a filesystem root');
+    }
+    if (process.platform === 'win32' && !/^[a-z]:[\\/][^:]+$/i.test(path)) {
+        throw new Error('Expected a local Windows drive path');
+    }
+    const canonical = realpathSync.native(path);
+    if (process.platform === 'win32' && !/^[a-z]:[\\/][^:]+$/i.test(canonical)) {
+        throw new Error('Expected a canonical local Windows drive path');
+    }
+    const normalizeCase = (value: string) => process.platform === 'win32' ? value.toLowerCase() : value;
+    if (normalizeCase(canonical) !== normalizeCase(normalize(path))) {
+        throw new Error('Path aliases are not eligible for restricted deployment');
+    }
+    return canonical;
+}
+
+export function readProjectIdentity(path: string): Readonly<{ canonicalPath: string; directoryIdentity: string }> {
+    const canonicalPath = canonicalLocalPath(path);
+    const stats = statSync(canonicalPath, { bigint: true });
+    if (!stats.isDirectory() || stats.ino === 0n) {
+        throw new Error('Project directory identity is unavailable');
+    }
+    return { canonicalPath, directoryIdentity: `${stats.dev}:${stats.ino}` };
+}
+
+function readPolicyJson(path: string): unknown {
+    const descriptor = openSync(path, constants.O_RDONLY | (constants.O_NOFOLLOW ?? 0));
+    try {
+        const stats = fstatSync(descriptor);
+        if (!stats.isFile() || stats.size === 0 || stats.size > MAX_POLICY_BYTES) {
+            throw new Error('Restricted deployment policy must be a bounded regular file');
+        }
+        if (process.getuid && (stats.uid !== process.getuid() || (stats.mode & 0o077) !== 0)) {
+            throw new Error('Restricted deployment policy must be private to the local owner');
+        }
+        const buffer = Buffer.alloc(MAX_POLICY_BYTES + 1);
+        let length = 0;
+        while (length < buffer.length) {
+            const read = readSync(descriptor, buffer, length, buffer.length - length, null);
+            if (read === 0) break;
+            length += read;
+        }
+        if (length !== stats.size) throw new Error('Restricted deployment policy changed during publication');
+        return JSON.parse(buffer.subarray(0, length).toString('utf8'));
+    } finally {
+        closeSync(descriptor);
+    }
+}
+
+export function loadRestrictedDeploymentPolicy(path: string): RestrictedDeploymentPolicy {
+    const canonicalPolicyPath = canonicalLocalPath(path);
+    const policy = policySchema.parse(readPolicyJson(canonicalPolicyPath));
+    if (new Set(policy.profiles.map(profile => profile.id)).size !== PROFILE_IDS.length) {
+        throw new Error('Restricted deployment requires four distinct profiles');
+    }
+    if (policy.profiles.some(profile => profile.id === 'babel' && profile.remoteSettings.length !== 0)) {
+        throw new Error('The Babel profile forbids remote settings');
+    }
+    const projectIds = new Set<string>();
+    const directoryIds = new Set<string>();
+    for (const project of policy.projects) {
+        const identity = readProjectIdentity(project.canonicalPath);
+        if (identity.directoryIdentity !== project.directoryIdentity || projectIds.has(project.projectId)
+            || directoryIds.has(identity.directoryIdentity)) {
+            throw new Error('Invalid or duplicate restricted project identity');
+        }
+        const policyRelativeToProject = relative(identity.canonicalPath, canonicalPolicyPath);
+        if (policyRelativeToProject !== '..' && !policyRelativeToProject.startsWith(`..${sep}`)
+            && !isAbsolute(policyRelativeToProject)) {
+            throw new Error('Restricted deployment policy must be outside all project directories');
+        }
+        project.canonicalPath = identity.canonicalPath;
+        projectIds.add(project.projectId);
+        directoryIds.add(identity.directoryIdentity);
+    }
+    return policy;
+}
