+import {
+    isRestrictedDeploymentConfigured,
+    loadRestrictedDeploymentPolicy,
+    readProjectIdentity,
+    RESTRICTED_DEPLOYMENT_MODE_ENV,
+    RESTRICTED_DEPLOYMENT_POLICY_ENV,
+    type RestrictedDeploymentPolicy,
+} from './policy';
+
+type RpcAdmission = (method: string, params: unknown) => boolean;
+
+/** Evaluate only explicitly supported deployed RPCs against a startup policy snapshot. */
+export function createRestrictedRpcAdmission(input: Readonly<{
+    scope?: 'machine' | 'session';
+    getSessionDirectory?: () => string | null;
+    env?: NodeJS.ProcessEnv;
+}>): RpcAdmission | undefined {
+    const env = input.env ?? process.env;
+    if (!isRestrictedDeploymentConfigured(env)) return undefined;
+    const mode = env[RESTRICTED_DEPLOYMENT_MODE_ENV];
+    const policyPath = env[RESTRICTED_DEPLOYMENT_POLICY_ENV];
+    const getSessionDirectory = input.getSessionDirectory;
+    if (mode !== '1' || !policyPath || input.scope !== 'session' || !getSessionDirectory) {
+        return () => false;
+    }
+
+    try {
+        const policy = loadRestrictedDeploymentPolicy(policyPath);
+        let boundProject: RestrictedDeploymentPolicy['projects'][number] | undefined;
+        const sessionMethods = new Set(policy.allowedSessionMethods);
+        const forbiddenMethods = new Set(policy.forbiddenMethods);
+        return (method, params) => {
+            // Other operations require a receiver-owned schema and a separately integrated grant/control path.
+            if (method !== 'session.workState.get' || !sessionMethods.has(method) || forbiddenMethods.has(method)) return false;
+            if (!params || typeof params !== 'object' || Array.isArray(params) || Object.keys(params).length !== 0) return false;
+            try {
+                const directory = getSessionDirectory();
+                if (!directory) return false;
+                const current = readProjectIdentity(directory);
+                boundProject ??= policy.projects.find(candidate => candidate.canonicalPath === current.canonicalPath
+                    && candidate.directoryIdentity === current.directoryIdentity);
+                return current.canonicalPath === boundProject?.canonicalPath && current.directoryIdentity === boundProject.directoryIdentity;
+            } catch {
+                return false;
+            }
+        };
+    } catch {
+        return () => false;
+    }
+}
diff --git a/apps/cli/src/security/restrictedDeployment/policy.test.ts b/apps/cli/src/security/restrictedDeployment/policy.test.ts
